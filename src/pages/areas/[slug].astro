---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageCta from '../../components/PageCta.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import GlassCard from '../../components/ui/GlassCard.astro';
import Reveal from '../../components/ui/Reveal.astro';
import { areas, type Area } from '../../data/areas';
import { SITE_NAME } from '../../data/site';

const areaImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/area-*.png', {
  eager: true,
});

export function getStaticPaths() {
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

interface Props {
  area: Area;
}

const { area } = Astro.props;
const heroImg = areaImages[`../../assets/img/area-${area.slug}.png`]?.default;
const title = `${area.titulo} — ${SITE_NAME}`;
const outras = areas.filter((a) => a.slug !== area.slug);

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/** Itálico dourado na segunda metade (após " e " / " & ") ou, sem conjunção, na última palavra. */
function italicTitle(t: string) {
  const m = t.match(/^(.*?\s(?:e|&)\s)(.+)$/);
  if (m) return `${esc(m[1])}<em class="em-gold">${esc(m[2])}</em>`;
  const words = t.split(' ');
  const last = words.pop() ?? '';
  return `${esc(words.join(' '))} <em class="em-gold">${esc(last)}</em>`;
}
/** Última palavra em itálico (mantém pontuação final fora do itálico). */
function italicLast(t: string) {
  const m = t.match(/^(.*\s)(\S+?)([.!?]?)$/);
  if (!m) return esc(t);
  return `${esc(m[1])}<em class="em-gold">${esc(m[2])}</em>${esc(m[3])}`;
}
---

<BaseLayout title={title} description={area.descricao}>
  <main>
    <PageHero
      tag="Área de Atuação"
      title={area.titulo}
      titleHtml={italicTitle(area.titulo)}
      lead={area.descricao}
      crumbs={[
        { label: 'Início', href: '/' },
        { label: 'Áreas de Atuação', href: '/#areas' },
        { label: area.titulo },
      ]}
      image={heroImg}
    />

    <!-- Visão geral -->
    <section class="section area-intro">
      <div class="container">
        <SectionHead eyebrow="Visão geral" align="left">
          <Fragment set:html={italicLast(area.introTitulo)} />
        </SectionHead>

        <div class="intro-grid">
          <div class="intro-copy">
            {area.intro.map((paragrafo) => <p>{paragrafo}</p>)}
            <a class="intro-link" href="/a-advogada">Conheça a trajetória da Dra. Érika</a>
          </div>

          <Reveal delay={120}>
            <GlassCard radius="md" class="quem-card">
              <span class="quem-tag">Para quem é</span>
              <h3>Esta atuação é para você?</h3>
              <p class="quem-lead">{area.paraQuem.texto}</p>
              <ul class="perfis">
                {area.paraQuem.perfis.map((perfil) => <li>{perfil}</li>)}
              </ul>
            </GlassCard>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- O que fazemos -->
    <section class="section section-navy-deep area-topics">
      <div class="container">
        <SectionHead
          eyebrow="Atuação"
          align="left"
          lead="Frentes concretas de trabalho nesta área — sempre precedidas de um diagnóstico do seu caso."
        >
          O que <em class="em-gold">fazemos</em>
        </SectionHead>

        <div class="topics-grid">
          {
            area.topicos.map((topico, i) => (
              <Reveal delay={(i % 3) * 90}>
                <GlassCard radius="sm" padding="sm" as="article" class="topic">
                  <span class="topic-idx">
                    <span class="diamond" aria-hidden="true" />
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3>{topico.titulo}</h3>
                  <p>{topico.texto}</p>
                </GlassCard>
              </Reveal>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Outras áreas -->
    <section class="section area-outras">
      <div class="container">
        <SectionHead eyebrow="Outras áreas" align="left">
          Conheça as <em class="em-gold">demais áreas</em>
        </SectionHead>

        <div class="outras-grid">
          {
            outras.map((o) => (
              <GlassCard radius="sm" padding="sm" as="a" href={`/areas/${o.slug}/`} class="outra">
                <h3>{o.titulo}</h3>
                <p>{o.descricao}</p>
                <span class="outra-go">Saiba mais</span>
              </GlassCard>
            ))
          }
        </div>
      </div>
    </section>

    <PageCta
      title="Vamos conversar sobre o seu caso?"
      titleHtml='Vamos conversar <em class="em-gold">sobre o seu caso</em>?'
      text="Envie uma mensagem descrevendo a sua situação e receba uma leitura técnica e humana — o primeiro passo de qualquer estrutura bem construída."
      label="Falar no WhatsApp"
    />
  </main>
</BaseLayout>

<style>
  /* ---------- visão geral ---------- */
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .intro-copy p {
    color: var(--ink-soft);
  }
  .intro-copy p + p {
    margin-top: 1.3rem;
  }
  .intro-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.8rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-gold-light);
    transition: gap 0.3s ease;
  }
  .intro-link::after {
    content: "→";
  }
  .intro-link:hover {
    gap: 0.8rem;
  }

  .quem-card {
    display: flex;
    flex-direction: column;
  }
  .quem-tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold-light);
    margin-bottom: 0.9rem;
  }
  .quem-card h3 {
    margin-bottom: 0.7rem;
  }
  .quem-lead {
    color: var(--ink-soft);
    padding-bottom: 1.2rem;
    margin-bottom: 1.2rem;
    border-bottom: 1px solid var(--ivory-line);
  }
  .perfis {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.8rem;
  }
  .perfis li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .perfis li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border: 1px solid var(--color-gold-mid);
    transform: rotate(45deg);
  }

  /* ---------- o que fazemos ---------- */
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .topics-grid :global([data-reveal]) {
    display: flex;
  }
  .topic {
    flex: 1;
    display: flex;
    flex-direction: column;
    transition: transform 0.4s var(--ease-out), border-color 0.4s ease;
  }
  .topic:hover {
    transform: translateY(-4px);
    border-color: var(--gold-line);
  }
  .topic-idx {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-gold-light);
    margin-bottom: 1.1rem;
  }
  .diamond {
    width: 9px;
    height: 9px;
    background: var(--gold-gradient);
    transform: rotate(45deg);
  }
  .topic h3 {
    font-size: 1.45rem;
    margin-bottom: 0.6rem;
  }
  .topic p {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  /* ---------- outras áreas ---------- */
  .outras-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .outra {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.4s var(--ease-out), border-color 0.4s ease;
  }
  .outra:hover {
    transform: translateY(-4px);
    border-color: var(--gold-line);
  }
  .outra h3 {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }
  .outra p {
    font-size: 0.9rem;
    color: var(--ink-soft);
    flex: 1;
  }
  .outra-go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.2rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-gold-light);
    transition: gap 0.3s ease;
  }
  .outra-go::after {
    content: "→";
  }
  .outra:hover .outra-go {
    gap: 0.8rem;
  }

  @media (max-width: 1024px) {
    .topics-grid,
    .outras-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 860px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .topics-grid,
    .outras-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
