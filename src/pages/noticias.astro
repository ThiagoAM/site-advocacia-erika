---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageCta from '../components/PageCta.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import Reveal from '../components/ui/Reveal.astro';
import { SITE_NAME } from '../data/site';
import { getNoticias, formatarDataNoticia } from '../data/noticias';

const title = `Conteúdo & Notícias — ${SITE_NAME}`;
const description =
  'Seleção diária de notícias sobre direito imobiliário, notarial e registral e planejamento patrimonial, com a curadoria da Dra. Érika Saquetti Martins.';

/** Feed mantido no repositório agentic-news — ver docs/noticias-pipeline.md. */
const { dataBusca, noticias } = await getNoticias();
const atualizadoEm = dataBusca ? formatarDataNoticia(dataBusca) : '';
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero
      tag="Conteúdo"
      title="Conteúdo & Notícias"
      titleHtml='Conteúdo &amp; <em class="em-gold">Notícias</em>'
      lead="Uma seleção diária de notícias e movimentos relevantes em direito imobiliário, notarial e registral e planejamento patrimonial — com o filtro de quem pesquisa e atua na área."
      crumbs={[{ label: 'Início', href: '/' }, { label: 'Conteúdo' }]}
    />

    <!-- curadoria -->
    <section class="section curadoria">
      <div class="container">
        <SectionHead eyebrow="Curadoria" align="left">
          O que você <em class="em-gold">encontra aqui</em>.
        </SectionHead>

        <div class="cur-copy">
          <p>
            Todos os dias, o noticiário jurídico e econômico produz decisões, normas e tendências
            que afetam diretamente quem possui, negocia ou transmite patrimônio. Esta página reúne
            uma seleção do que importa — teses dos tribunais superiores, mudanças em regularização
            fundiária e REURB, atos notariais e registrais, e movimentos do planejamento
            patrimonial e sucessório.
          </p>
          <p>
            A curadoria é informativa e não substitui a análise do seu caso concreto: cada situação
            pede leitura própria, com documentos e contexto.
          </p>
        </div>
      </div>
    </section>

    <!-- notícias -->
    <section class="section section-navy-deep news" id="conteudo">
      <div class="container">
        <div class="news-head-row">
          <SectionHead eyebrow="Notícias & Conteúdo" align="left">
            O direito em movimento, <em class="em-gold">lido com precisão</em>.
          </SectionHead>
          <span class="live-note"><span class="live-dot" aria-hidden="true"></span>Atualizado diariamente</span>
        </div>

        {
          noticias.length > 0 ? (
            <>
              <div class="news-grid">
                {noticias.map((noticia, i) => (
                  <Reveal delay={(i % 3) * 90}>
                    <GlassCard radius="md" as="article" class="news-card">
                      <div class="news-meta">
                        <span>{noticia.fonte}</span>
                        <span class="sep" aria-hidden="true" />
                        <time datetime={noticia.data_publicacao}>
                          {formatarDataNoticia(noticia.data_publicacao)}
                        </time>
                      </div>
                      <h3>
                        <a
                          href={noticia.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`${noticia.titulo} — abre em nova aba`}
                        >
                          {noticia.titulo}
                        </a>
                      </h3>
                      <p class="news-desc">{noticia.descricao}</p>
                      <span class="news-link" aria-hidden="true">
                        Ler na fonte
                      </span>
                    </GlassCard>
                  </Reveal>
                ))}
              </div>

              {atualizadoEm && (
                <p class="news-stamp">
                  <span class="news-stamp-tag">Curadoria</span>
                  Atualizado em {atualizadoEm}.
                </p>
              )}
            </>
          ) : (
            <Reveal>
              <GlassCard radius="md" padding="lg" class="news-empty">
                <p class="news-empty-title">A curadoria de hoje está em atualização.</p>
                <p class="news-empty-text">
                  Volte em instantes — a seleção é renovada diariamente. Enquanto isso, conheça
                  as <a href="/#areas">áreas de atuação</a> do escritório.
                </p>
              </GlassCard>
            </Reveal>
          )
        }
      </div>
    </section>

    <PageCta
      title="Uma notícia tocou o seu caso?"
      titleHtml='Uma notícia tocou <em class="em-gold">o seu caso</em>?'
      text="Envie uma mensagem e converse diretamente sobre a sua situação — sem juridiquês, com leitura técnica e objetiva."
    />
  </main>
</BaseLayout>

<style>
  .cur-copy {
    max-width: 46rem;
  }
  .cur-copy p {
    color: var(--ink-soft);
  }
  .cur-copy p + p {
    margin-top: 1.3rem;
  }

  .news-head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .live-note {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-gold-mid);
    box-shadow: 0 0 0 3px rgba(184, 153, 107, 0.28);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .news-grid :global([data-reveal]) {
    display: flex;
  }
  .news-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    transition: border-color 0.4s ease, transform 0.4s var(--ease-out);
  }
  .news-card:hover {
    border-color: var(--gold-line);
    transform: translateY(-4px);
  }
  .news-meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-light);
    margin-bottom: 1rem;
  }
  .news-meta .sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-gold-mid);
  }
  .news-card h3 {
    font-size: 1.5rem;
  }
  .news-card h3 a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  /* o título estende o clique para o cartão inteiro (.glass é position: relative) */
  .news-card h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .news-card:hover h3 a {
    color: var(--color-gold-light);
  }
  .news-desc {
    flex: 1;
    margin-top: 0.9rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .news-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.4rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ivory);
    transition: gap 0.3s ease, color 0.3s ease;
  }
  .news-link::after {
    content: "→";
    color: var(--color-gold-light);
  }
  .news-card:hover .news-link {
    color: var(--color-gold-light);
    gap: 0.8rem;
  }

  .news-stamp {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2.4rem;
    padding: 1rem 1.4rem;
    border-radius: var(--radius-sm);
    border: var(--card-border);
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .news-stamp-tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold-light);
    white-space: nowrap;
  }

  .news-empty {
    max-width: 42rem;
    text-align: center;
    margin-inline: auto;
  }
  .news-empty-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.35;
  }
  .news-empty-text {
    margin-top: 0.9rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .news-empty-text a {
    color: var(--color-gold-light);
    border-bottom: 1px solid var(--gold-line);
  }
  .news-empty-text a:hover {
    border-color: var(--color-gold-light);
  }

  @media (max-width: 1024px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
