---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Credibilidade from '../components/Credibilidade.astro';
import Areas from '../components/Areas.astro';
import Advogada from '../components/Advogada.astro';
import Educacao from '../components/Educacao.astro';
import Noticias from '../components/Noticias.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { areas } from '../data/areas';

const title = 'Saquetti Martins Advocacia — Protegendo patrimônios. Construindo legados.';
const description =
  'Advocacia consultiva premium em Direito Imobiliário, Notarial e Registral, REURB e Planejamento Patrimonial e Sucessório. Dra. Érika Silvana Saquetti Martins — Brasil, EUA, Canadá e Portugal.';
---

<BaseLayout title={title} description={description}>
  <main id="inicio">
    <Hero />
    <Credibilidade />
    <Areas areas={areas} />
    <Advogada />
    <Educacao />
    <Noticias />
    <CtaFinal />
  </main>
</BaseLayout>
