---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageCta from '../components/PageCta.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import IconSquare from '../components/ui/IconSquare.astro';
import Chip from '../components/ui/Chip.astro';
import Reveal from '../components/ui/Reveal.astro';
import { Image } from 'astro:assets';
import fotoErika from '../assets/img/erika.jpg';
import heroImg from '../assets/img/hero-a-advogada.png';
import { SITE_NAME, OAB } from '../data/site';

const title = `Dra. Érika Silvana Saquetti Martins — ${SITE_NAME}`;
const description =
  'Advogada desde 2009 (OAB/PR), Doutora em Direito com pesquisa em REURB, Mestre pela UFPR e pela UNINTER, professora de pós-graduação e palestrante. Atendimento no Brasil, EUA, Canadá e Portugal.';

const marcos = [
  {
    periodo: 'Início da carreira',
    titulo: 'Tribunal Regional do Trabalho do Paraná',
    texto:
      'Servidora do TRT-PR, onde formou a disciplina técnica e o respeito pelo rito que marcam sua prática até hoje.',
  },
  {
    periodo: '2009',
    titulo: 'Ingresso na advocacia',
    texto:
      'Início da atuação como advogada (OAB/PR), com vocação clara desde cedo: prevenir conflitos antes que eles existam.',
  },
  {
    periodo: 'Pesquisa acadêmica',
    titulo: 'Mestrados e doutorado',
    texto:
      'Da prática nasceu a pesquisa: mestrado em Políticas Públicas (UFPR) e em Direito (UNINTER), e doutorado em Direito com pesquisa em REURB.',
  },
  {
    periodo: 'Hoje',
    titulo: 'Advocacia, docência e atuação internacional',
    texto:
      'Advocacia consultiva, docência em pós-graduação, palestras e publicações — com clientes no Brasil, nos EUA, no Canadá e em Portugal.',
  },
];

const formacao = [
  {
    titulo: 'Doutora em Direito',
    texto: 'Pesquisa dedicada à Regularização Fundiária Urbana (REURB).',
  },
  {
    titulo: 'Mestre em Políticas Públicas — UFPR',
    texto: 'Universidade Federal do Paraná, com foco em regularização fundiária.',
  },
  {
    titulo: 'Mestre em Direito — UNINTER',
    texto: 'Pesquisa sobre o sistema multiportas nas serventias extrajudiciais.',
  },
];

const especializacoes = [
  'Direito Público',
  'Direito Notarial e Registral',
  'Direito do Trabalho e Processo do Trabalho',
  'Direito Imobiliário',
  'Direito de Família e Sucessão Extrajudicial',
];

const comissoes = [
  'Comissão de Direito à Cidade — OAB/PR',
  'Comissão de Direito Notarial e das Serventias Extrajudicial e Judicial — OAB/PR',
  'Comissão de Gestão e Empreendedorismo — OAB/PR',
];

const associacoes = [
  'Membro do Time Holding Brasil',
  'Associada ao CONPEDI — Conselho Nacional de Pesquisa e Pós-Graduação em Direito',
  'Associada ao IBRADIM — Instituto Brasileiro de Direito Imobiliário',
];
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero
      tag="A Advogada"
      title="Dra. Érika Silvana Saquetti Martins"
      titleHtml='Dra. Érika Silvana <em class="em-gold">Saquetti Martins</em>'
      lead="Advogada desde 2009 (OAB/PR 52.743), professora e pesquisadora — dedicada a simplificar questões jurídicas complexas, prevenir conflitos e proporcionar tranquilidade a famílias e investidores."
      crumbs={[{ label: 'Início', href: '/' }, { label: 'A Advogada' }]}
      image={heroImg}
    />

    <!-- Trajetória -->
    <section class="section trajetoria">
      <div class="container">
        <SectionHead eyebrow="Trajetória" align="left">
          Do serviço público à <em class="em-gold">advocacia consultiva</em>.
        </SectionHead>

        <div class="traj-grid">
          <div class="traj-photo-col">
            <GlassCard radius="md" padding="none" as="figure" class="traj-photo">
              <span class="traj-photo-img">
                <Image
                  class="photo-grade"
                  src={fotoErika}
                  alt="Dra. Érika Silvana Saquetti Martins, advogada, em retrato profissional"
                  widths={[420, 640, 853]}
                  sizes="(max-width: 860px) 80vw, 32vw"
                  format="webp"
                  quality={82}
                />
                <span class="photo-tint" aria-hidden="true"></span>
              </span>
              <figcaption>Dra. Érika Silvana Saquetti Martins · {OAB}</figcaption>
            </GlassCard>
          </div>

          <div class="traj-copy">
            <p>
              A trajetória da Dra. Érika começa no serviço público, como servidora do Tribunal
              Regional do Trabalho do Paraná. Em 2009, ingressou na advocacia — e ali encontrou a
              sua forma de exercer o direito: a atuação preventiva e consultiva, que resolve o
              problema antes que ele se torne litígio.
            </p>
            <p>
              Da prática nasceu a pesquisa. A convivência diária com imóveis irregulares e
              sucessões mal resolvidas levou-a à academia: mestrado em Políticas Públicas na UFPR,
              com foco em regularização fundiária; mestrado em Direito na UNINTER, dedicado ao
              sistema multiportas nas serventias extrajudiciais; e doutorado em Direito, com
              pesquisa em REURB.
            </p>
            <p>
              Hoje, soma à advocacia a docência em cursos de pós-graduação, a formação de
              profissionais do mercado imobiliário e a atuação como palestrante e escritora —
              atendendo clientes no Brasil, nos Estados Unidos, no Canadá e em Portugal.
            </p>

            <ol class="timeline">
              {
                marcos.map((marco, i) => (
                  <Reveal as="li" delay={i * 90}>
                    <span class="tl-periodo">{marco.periodo}</span>
                    <h3>{marco.titulo}</h3>
                    <p>{marco.texto}</p>
                  </Reveal>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- Formação -->
    <section class="section section-navy-deep formacao">
      <div class="container">
        <SectionHead eyebrow="Formação" align="left">
          Formação <em class="em-gold">acadêmica</em>.
        </SectionHead>

        <h3 class="group-label">Pós-graduação stricto sensu</h3>
        <div class="grid-3">
          {
            formacao.map((item, i) => (
              <Reveal delay={i * 90}>
                <GlassCard radius="md" class="form-card">
                  <IconSquare tone="navy">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 9.5 12 5l9 4.5-9 4.5z" />
                      <path d="M7 11.5V16c0 1.5 2.5 3 5 3s5-1.5 5-3v-4.5" />
                      <path d="M21 9.5V15" />
                    </svg>
                  </IconSquare>
                  <h4>{item.titulo}</h4>
                  <p>{item.texto}</p>
                </GlassCard>
              </Reveal>
            ))
          }
        </div>

        <h3 class="group-label mt">Especializações</h3>
        <div class="chips">
          {especializacoes.map((item) => <Chip>{item}</Chip>)}
        </div>
      </div>
    </section>

    <!-- Docência -->
    <section class="section docencia">
      <div class="container">
        <SectionHead eyebrow="Docência" align="left">
          Quem pesquisa, <em class="em-gold">ensina</em>.
        </SectionHead>

        <div class="grid-3">
          <Reveal>
            <GlassCard radius="md" class="doc-card">
              <IconSquare tone="gold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 5h16v11H4z" />
                  <path d="M9 20h6M12 16v4" />
                </svg>
              </IconSquare>
              <h3>Pós-graduação</h3>
              <p>
                Professora de cursos de pós-graduação na UNINTER e na PUC, nas disciplinas de Direito
                Imobiliário, Direito Constitucional, Processo Civil, Gestão de Cartórios e
                Regularização Fundiária.
              </p>
            </GlassCard>
          </Reveal>
          <Reveal delay={90}>
            <GlassCard radius="md" class="doc-card">
              <IconSquare tone="gold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="8" r="3.5" />
                  <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" />
                  <path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14c2 .6 3.5 2.8 3.5 6" />
                </svg>
              </IconSquare>
              <h3>Formação profissional</h3>
              <p>
                Professora de corretores, arquitetos, engenheiros e advogados pela Escola Democrata e
                pelo Instituto dos Corretores de Santa Catarina e Oeste.
              </p>
            </GlassCard>
          </Reveal>
          <Reveal delay={180}>
            <GlassCard radius="md" class="doc-card">
              <IconSquare tone="gold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3v11" />
                  <path d="M8.5 14a3.5 3.5 0 0 0 7 0" />
                  <path d="M6 11a6 6 0 0 0 12 0M12 17v4M9 21h6" />
                </svg>
              </IconSquare>
              <h3>Palestras e publicações</h3>
              <p>
                Palestrante e escritora nas áreas de direito imobiliário, notarial e registral e
                planejamento patrimonial. Conheça os
                <a class="doc-link" href="/educacao">cursos e treinamentos</a>.
              </p>
            </GlassCard>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- Instituições -->
    <section class="section section-navy-deep instituicoes">
      <div class="container">
        <SectionHead eyebrow="Instituições" align="left">
          Comissões e <em class="em-gold">associações</em>.
        </SectionHead>

        <div class="grid-2">
          <Reveal>
            <GlassCard radius="md">
              <h3 class="group-label in-card">Comissões — OAB/PR</h3>
              <ul class="list">
                {comissoes.map((item) => <li>{item}</li>)}
              </ul>
            </GlassCard>
          </Reveal>
          <Reveal delay={90}>
            <GlassCard radius="md">
              <h3 class="group-label in-card">Associações e redes</h3>
              <ul class="list">
                {associacoes.map((item) => <li>{item}</li>)}
              </ul>
            </GlassCard>
          </Reveal>
        </div>
      </div>
    </section>

    <PageCta
      title="Uma conversa esclarece mais que mil páginas."
      titleHtml='Uma conversa esclarece <em class="em-gold">mais que mil páginas</em>.'
      text="Agende uma consulta — online ou presencial — e receba uma leitura técnica e humana da sua situação patrimonial."
      label="Agendar uma conversa"
    />
  </main>
</BaseLayout>

<style>
  /* ---------- trajetória ---------- */
  .traj-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .traj-photo-col {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .traj-photo {
    margin: 0;
    overflow: hidden;
  }
  .traj-photo-img {
    position: relative;
    display: block;
  }
  .traj-photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 15%;
  }
  .traj-photo figcaption {
    padding: 0.9rem 1.2rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-light);
    border-top: var(--card-border);
  }
  .traj-copy p {
    color: var(--ink-soft);
  }
  .traj-copy > p + p {
    margin-top: 1.3rem;
  }

  .timeline {
    position: relative;
    list-style: none;
    padding: 0;
    margin: clamp(2.4rem, 4vw, 3.2rem) 0 0;
  }
  .timeline::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: linear-gradient(180deg, var(--color-gold-light) 0%, rgba(217, 194, 154, 0.05) 100%);
  }
  .timeline :global(li) {
    position: relative;
    padding: 0 0 2rem 2rem;
  }
  .timeline :global(li:last-child) {
    padding-bottom: 0;
  }
  .timeline :global(li)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 9px;
    height: 9px;
    background: var(--gold-gradient);
    transform: rotate(45deg);
  }
  .tl-periodo {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold-light);
    margin-bottom: 0.35rem;
  }
  .timeline h3 {
    font-size: 1.45rem;
    margin-bottom: 0.3rem;
  }
  .timeline p {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  /* ---------- grids e cards ---------- */
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .grid-3 :global([data-reveal]),
  .grid-2 :global([data-reveal]) {
    display: flex;
  }
  .grid-3 :global(.glass),
  .grid-2 :global(.glass) {
    flex: 1;
  }
  .group-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-gold-light);
    margin-bottom: 1.2rem;
  }
  .group-label.mt {
    margin-top: clamp(2.4rem, 4vw, 3.2rem);
  }
  .group-label.in-card {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--ivory-line);
  }
  .form-card h4 {
    margin-top: 1.2rem;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 400;
    line-height: 1.2;
  }
  .form-card p,
  .doc-card p {
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  .doc-card h3 {
    margin-top: 1.2rem;
    font-size: 1.5rem;
  }
  .doc-link {
    color: var(--color-gold-light);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.3s ease;
  }
  .doc-link:hover {
    color: var(--color-ivory);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .chips :global(.chip) {
    white-space: normal;
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  .list li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border: 1px solid var(--color-gold-mid);
    transform: rotate(45deg);
  }

  @media (max-width: 1024px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 860px) {
    .traj-grid,
    .grid-2 {
      grid-template-columns: 1fr;
    }
    .traj-photo-col {
      position: static;
      max-width: 22rem;
    }
  }
</style>
