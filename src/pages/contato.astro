---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import heroImg from '../assets/img/hero-contato.png';
import IconWhatsApp from '../components/IconWhatsApp.astro';
import ContactForm from '../components/ContactForm.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import GlassCard from '../components/ui/GlassCard.astro';
import IconSquare from '../components/ui/IconSquare.astro';
import Button from '../components/ui/Button.astro';
import Reveal from '../components/ui/Reveal.astro';
import {
  EMAIL,
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  SITE_NAME,
  WHATSAPP_DISPLAY,
  WHATSAPP_DISPLAY_RJ,
  WHATSAPP_URL,
  WHATSAPP_URL_RJ,
} from '../data/site';

const title = `Contato — ${SITE_NAME}`;
const description =
  'Fale com a Dra. Érika Saquetti Martins por WhatsApp, e-mail ou Instagram. Atendimento presencial em Curitiba e online para todo o Brasil, inclusive para brasileiros que moram fora.';

const atendimento = [
  {
    titulo: 'Horário',
    texto:
      'De segunda a sexta-feira, das 9h às 18h (horário de Brasília). Mensagens recebidas fora desse horário são respondidas no próximo dia útil.',
  },
  {
    titulo: 'No Brasil',
    texto:
      'Base em Curitiba — PR, com atendimento online para todo o país. Consultas presenciais mediante agendamento.',
  },
  {
    titulo: 'Quem mora fora',
    texto:
      'Brasileiros que moram em outro país são atendidos por videoconferência, em horário compatível com o fuso — sempre sobre patrimônio, herança ou negócios no Brasil.',
  },
];
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero
      tag="Contato"
      title="Vamos conversar?"
      titleHtml='Vamos <em class="em-gold">conversar</em>?'
      lead="Atendimento consultivo, humano e direto — presencial em Curitiba e online para todo o Brasil, inclusive para quem mora fora."
      crumbs={[{ label: 'Início', href: '/' }, { label: 'Contato' }]}
      image={heroImg}
    />

    <!-- Canais diretos -->
    <section class="section canais">
      <div class="container">
        <SectionHead eyebrow="Canais diretos" align="left">
          Escolha o caminho <em class="em-gold">mais simples</em> para você.
        </SectionHead>

        <div class="canais-grid">
          <Reveal>
            <GlassCard radius="md" class="canal canal-wa">
              <IconSquare tone="gold" size={72}><IconWhatsApp /></IconSquare>
              <h3>WhatsApp</h3>
              <p class="canal-valor">{WHATSAPP_DISPLAY}</p>
              <p class="canal-alt">
                Também atendo em <a href={WHATSAPP_URL_RJ} target="_blank" rel="noopener">{WHATSAPP_DISPLAY_RJ}</a>
              </p>
              <p class="canal-desc">O canal mais rápido para primeiras conversas e agendamento de consultas.</p>
              <div class="canal-action">
                <Button href={WHATSAPP_URL} variant="gold" external icon="whatsapp">Iniciar conversa</Button>
              </div>
            </GlassCard>
          </Reveal>

          <Reveal delay={90}>
            <GlassCard radius="md" class="canal">
              <IconSquare tone="navy" size={72}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="2.5" y="5" width="19" height="14" rx="2"></rect>
                  <path d="m3.5 6.5 8.5 6.5 8.5-6.5"></path>
                </svg>
              </IconSquare>
              <h3>E-mail</h3>
              <p class="canal-valor">{EMAIL}</p>
              <p class="canal-desc">Para mensagens mais detalhadas e envio de documentos com organização.</p>
              <div class="canal-action">
                <a class="canal-go" href={`mailto:${EMAIL}`}>Escrever e-mail</a>
              </div>
            </GlassCard>
          </Reveal>

          <Reveal delay={180}>
            <GlassCard radius="md" class="canal">
              <IconSquare tone="navy" size={72}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"></circle>
                </svg>
              </IconSquare>
              <h3>Instagram</h3>
              <p class="canal-valor">{INSTAGRAM_HANDLE}</p>
              <p class="canal-desc">Conteúdo sobre direito imobiliário e patrimonial — e mensagens diretas.</p>
              <div class="canal-action">
                <a class="canal-go" href={INSTAGRAM_URL} target="_blank" rel="noopener">Seguir e conversar</a>
              </div>
            </GlassCard>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- Envie uma mensagem (Web3Forms / mailto) -->
    <ContactForm />

    <!-- Como funciona -->
    <section class="section atendimento">
      <div class="container">
        <SectionHead eyebrow="Atendimento" align="left">
          Como funciona <em class="em-gold">o atendimento</em>.
        </SectionHead>

        <div class="atd-grid">
          {
            atendimento.map((item, i) => (
              <Reveal delay={i * 90}>
                <GlassCard radius="md" class="atd-card">
                  <span class="atd-num em-gold">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{item.titulo}</h3>
                  <p>{item.texto}</p>
                </GlassCard>
              </Reveal>
            ))
          }
        </div>

        <div class="atd-cta">
          <Button href={WHATSAPP_URL} variant="gold" external icon="whatsapp">Agendar pelo WhatsApp</Button>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ---------- canais ---------- */
  .canais-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .canais-grid :global([data-reveal]),
  .atd-grid :global([data-reveal]) {
    display: flex;
  }
  .canal {
    flex: 1;
    display: flex;
    flex-direction: column;
    transition: border-color 0.4s ease;
  }
  .canal:hover {
    border-color: var(--gold-line);
  }
  .canal-wa {
    border-color: var(--gold-line);
  }
  .canal h3 {
    margin-top: 1.3rem;
    font-size: 1.6rem;
  }
  .canal-valor {
    margin-top: 0.2rem;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-gold-light);
    overflow-wrap: anywhere;
  }
  .canal-alt {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }
  .canal-alt a {
    color: var(--ink-soft);
    transition: color 0.3s ease;
  }
  .canal-alt a:hover {
    color: var(--color-gold-light);
  }
  .canal-desc {
    margin-top: 0.9rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    flex: 1;
  }
  .canal-action {
    margin-top: 1.6rem;
  }
  .canal-go {
    display: inline-flex;
    align-items: center;
    padding-block: 0.4rem;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ivory);
    transition: gap 0.3s ease, color 0.3s ease;
  }
  .canal-go::after {
    content: "→";
    color: var(--color-gold-light);
  }
  .canal-go:hover {
    color: var(--color-gold-light);
    gap: 0.8rem;
  }

  /* ---------- atendimento ---------- */
  .atendimento {
    background: var(--bg-alt);
  }
  .atd-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .atd-card {
    flex: 1;
  }
  .atd-num {
    display: block;
    font-family: var(--font-display);
    font-style: normal;
    font-size: 2.6rem;
    line-height: 1;
  }
  .atd-card h3 {
    margin-top: 1rem;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .atd-card p {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  .atd-cta {
    margin-top: clamp(2.4rem, 5vw, 3.5rem);
  }

  @media (max-width: 1024px) {
    .canais-grid,
    .atd-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
