---
import Brand from './Brand.astro';
import IconWhatsApp from './IconWhatsApp.astro';
import { areas } from '../data/areas';
import {
  EMAIL,
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  SLOGAN,
  WHATSAPP_DISPLAY,
  WHATSAPP_URL,
} from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Brand on="navy" />
        <p class="slogan">{SLOGAN}</p>
      </div>

      <nav class="footer-col" aria-label="Áreas de atuação">
        <h3>Áreas</h3>
        <ul>
          {
            areas.map((area) => (
              <li>
                <a href={`/areas/${area.slug}`}>{area.titulo}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-col footer-contact">
        <h3>Contato</h3>
        <ul>
          <li>
            <a href={WHATSAPP_URL} target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
              <IconWhatsApp />
              {WHATSAPP_DISPLAY}
            </a>
          </li>
          <li>
            <a href={`mailto:${EMAIL}`} aria-label="Enviar e-mail">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
                ><rect x="2.5" y="5" width="19" height="14" rx="2"></rect><path
                  d="m3.5 6.5 8.5 6.5 8.5-6.5"></path></svg
              >
              {EMAIL}
            </a>
          </li>
          <li>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
                ><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"
                ></circle><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"
                ></circle></svg
              >
              {INSTAGRAM_HANDLE}
            </a>
          </li>
          <li><span>Curitiba — PR · Atendimento no Brasil e no exterior</span></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-in">
      <p>Conteúdo informativo — em conformidade com o Provimento 205/2021 da OAB.</p>
      <p>
        © 2026 Saquetti Martins Advocacia · Todos os direitos reservados ·
        <a href="/politica-de-privacidade">Política de Privacidade</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy-deep);
    color: var(--ivory-soft);
    padding: clamp(3.5rem, 7vw, 5.5rem) 0 0;
    border-top: 1px solid var(--gold-faint);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: 3rem;
  }
  .footer-brand > :global(.brand) {
    margin-bottom: 1.4rem;
  }
  .footer-brand .slogan {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--gold-text);
    max-width: 20rem;
    line-height: 1.45;
  }
  .footer-col h3 {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold-text);
    margin-bottom: 1.3rem;
    line-height: 1.7;
  }
  .footer-col li {
    margin-bottom: 0.65rem;
  }
  .footer-col a,
  .footer-col span {
    font-size: 0.86rem;
    font-weight: 400;
    color: var(--ivory-soft);
    transition: color 0.3s ease;
  }
  .footer-col a:hover {
    color: var(--gold-text);
  }
  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .footer-contact a :global(svg) {
    width: 15px;
    height: 15px;
    color: var(--gold-text);
    flex: none;
  }

  .footer-bottom {
    border-top: 1px solid rgba(251, 251, 248, 0.09);
    padding: 1.6rem 0 2rem;
  }
  .footer-bottom-in {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2.5rem;
    justify-content: space-between;
    align-items: center;
  }
  .footer-bottom p {
    font-size: 0.72rem;
    font-weight: 400;
    color: rgba(251, 251, 248, 0.75);
    letter-spacing: 0.04em;
  }
  .footer-bottom a {
    color: rgba(251, 251, 248, 0.82);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.3s ease;
  }
  .footer-bottom a:hover {
    color: var(--gold-text);
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
