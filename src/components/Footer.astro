---
import LogoVertical from '../assets/brand/logo-vertical-light.svg';
import Eyebrow from './ui/Eyebrow.astro';
import IconWhatsApp from './IconWhatsApp.astro';
import {
  OAB,
  EMAIL,
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  SLOGAN,
  WHATSAPP_DISPLAY,
  WHATSAPP_URL,
} from '../data/site';

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/a-advogada', label: 'A Advogada' },
  { href: '/#areas', label: 'Áreas de Atuação' },
  { href: '/educacao', label: 'Educação' },
  { href: '/noticias', label: 'Notícias' },
  { href: '/contato', label: 'Contato' },
];
---

<footer class="site-footer">
  <span class="pattern-veil" aria-hidden="true"></span>
  <span class="footer-glow" aria-hidden="true"></span>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Saquetti Martins Advocacia — início">
          <LogoVertical aria-hidden="true" role="presentation" aria-label={undefined} />
        </a>
        <p class="slogan">{SLOGAN}</p>
        <p class="oab">Dra. Érika Silvana Saquetti Martins · {OAB}</p>
      </div>

      <nav class="footer-col" aria-label="Navegação do rodapé">
        <Eyebrow as="h2">Navegação</Eyebrow>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-col footer-contact">
        <Eyebrow as="h2">Contatos</Eyebrow>
        <ul>
          <li>
            <a href={WHATSAPP_URL} target="_blank" rel="noopener">
              <span class="ic" aria-hidden="true"><IconWhatsApp /></span>
              <span><span class="lbl">WhatsApp</span>{WHATSAPP_DISPLAY}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${EMAIL}`}>
              <span class="ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                  ><rect x="2.5" y="5" width="19" height="14" rx="2"></rect><path d="m3.5 6.5 8.5 6.5 8.5-6.5"
                  ></path></svg
                >
              </span>
              <span><span class="lbl">E-mail</span>{EMAIL}</span>
            </a>
          </li>
          <li>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener">
              <span class="ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                  ><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle
                    cx="17.2"
                    cy="6.8"
                    r="1.1"
                    fill="currentColor"
                    stroke="none"></circle></svg
                >
              </span>
              <span><span class="lbl">Instagram</span>{INSTAGRAM_HANDLE}</span>
            </a>
          </li>
          <li class="place">Curitiba — PR · Atendimento no Brasil e no exterior</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-in">
      <p>Conteúdo informativo, em conformidade com o Provimento 205/2021 da OAB.</p>
      <p>
        © 2026 Saquetti Martins Advocacia ·
        <a href="/politica-de-privacidade">Política de Privacidade</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer .pattern-veil {
    opacity: 0.04;
  }
  .site-footer {
    position: relative;
    background: linear-gradient(180deg, var(--color-ink-900) 0%, var(--color-abyss) 60%);
    color: var(--ink-soft);
    padding: clamp(3.5rem, 7vw, 5.5rem) 0 0;
    overflow: clip;
  }
  /* fio de luz no topo, no lugar do padrão em mosaico da v2 */
  .site-footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(251, 251, 248, 0) 0%, rgba(217, 194, 154, 0.34) 50%, rgba(251, 251, 248, 0) 100%);
    pointer-events: none;
  }
  /* brilho dourado bem discreto atrás da marca */
  .footer-glow {
    position: absolute;
    z-index: 0;
    left: -6%;
    top: -30%;
    width: min(720px, 90%);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: radial-gradient(50% 50% at 50% 50%, rgba(184, 153, 107, 0.13) 0%, rgba(134, 109, 75, 0.05) 42%, rgba(1, 6, 15, 0) 70%);
    pointer-events: none;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.2fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: 3rem;
  }
  .footer-logo {
    display: inline-block;
    transition: opacity 0.3s ease;
  }
  .footer-logo:hover {
    opacity: 0.82;
  }
  .footer-logo :global(svg) {
    width: 190px;
    height: auto;
    display: block;
  }
  .footer-brand .slogan {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.4rem;
    letter-spacing: 0.01em;
    color: var(--color-gold-light);
    max-width: 20rem;
    line-height: 1.35;
    margin-top: 1.4rem;
  }
  .footer-brand .oab {
    font-size: 0.8125rem;
    margin-top: 0.8rem;
    color: var(--ink-soft);
  }
  .footer-col :global(.eyebrow) {
    margin-bottom: 1.4rem;
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-col li {
    margin-bottom: 0.15rem;
  }
  .footer-col a {
    display: inline-block;
    padding-block: 0.42rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    transition: color 0.3s ease;
  }
  .footer-col a:hover {
    color: var(--color-gold-light);
  }
  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }
  .footer-contact li {
    margin-bottom: 0.6rem;
    min-width: 0;
  }
  .footer-contact a {
    padding-block: 0.3rem;
  }
  .footer-contact a > span:last-child {
    overflow-wrap: anywhere;
  }
  .footer-contact .lbl {
    display: block;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .footer-contact .ic {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(217, 194, 154, 0.32);
    background: rgba(251, 251, 248, 0.03);
    color: var(--color-gold-light);
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease;
  }
  .footer-contact a:hover .ic {
    border-color: var(--color-gold-light);
    background: rgba(217, 194, 154, 0.1);
  }
  .footer-contact .ic :global(svg) {
    width: 16px;
    height: 16px;
  }
  .footer-contact .place {
    font-size: 0.875rem;
    color: var(--ink-soft);
    margin-top: 0.4rem;
  }

  .footer-bottom {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--ivory-line);
    padding: 1.5rem 0 2rem;
  }
  .footer-bottom-in {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2.5rem;
    justify-content: space-between;
    align-items: center;
  }
  .footer-bottom p {
    font-size: 0.75rem;
    color: var(--ink-soft);
    letter-spacing: 0.03em;
  }
  .footer-bottom a {
    color: var(--color-ivory);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.3s ease;
  }
  .footer-bottom a:hover {
    color: var(--color-gold-light);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
