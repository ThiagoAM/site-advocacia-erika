---
import LogoVertical from '../assets/brand/logo-vertical-mono.svg';
import patternTile from '../assets/brand/pattern-tile.svg?url';
import Eyebrow from './ui/Eyebrow.astro';
import IconWhatsApp from './IconWhatsApp.astro';
import {
  OAB,
  EMAIL,
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  SLOGAN,
  WHATSAPP_DISPLAY,
  WHATSAPP_URL,
} from '../data/site';

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/a-advogada', label: 'A Advogada' },
  { href: '/#areas', label: 'Áreas de Atuação' },
  { href: '/educacao', label: 'Educação' },
  { href: '/noticias', label: 'Notícias' },
  { href: '/contato', label: 'Contato' },
];
---

<footer class="site-footer" style={`--pattern: url(${patternTile})`}>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Saquetti Martins Advocacia — início">
          <LogoVertical aria-hidden="true" role="presentation" aria-label={undefined} />
        </a>
        <p class="slogan">{SLOGAN}</p>
        <p class="oab">Dra. Érika Silvana Saquetti Martins · {OAB}</p>
      </div>

      <nav class="footer-col" aria-label="Navegação do rodapé">
        <Eyebrow as="h2">Navegação</Eyebrow>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-col footer-contact">
        <Eyebrow as="h2">Contatos</Eyebrow>
        <ul>
          <li>
            <a href={WHATSAPP_URL} target="_blank" rel="noopener">
              <span class="ic" aria-hidden="true"><IconWhatsApp /></span>
              <span><span class="lbl">WhatsApp</span>{WHATSAPP_DISPLAY}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${EMAIL}`}>
              <span class="ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                  ><rect x="2.5" y="5" width="19" height="14" rx="2"></rect><path d="m3.5 6.5 8.5 6.5 8.5-6.5"
                  ></path></svg
                >
              </span>
              <span><span class="lbl">E-mail</span>{EMAIL}</span>
            </a>
          </li>
          <li>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener">
              <span class="ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                  ><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle
                    cx="17.2"
                    cy="6.8"
                    r="1.1"
                    fill="currentColor"
                    stroke="none"></circle></svg
                >
              </span>
              <span><span class="lbl">Instagram</span>{INSTAGRAM_HANDLE}</span>
            </a>
          </li>
          <li class="place">Curitiba — PR · Atendimento no Brasil e no exterior</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-in">
      <p>Conteúdo informativo, em conformidade com o Provimento 205/2021 da OAB.</p>
      <p>
        © 2026 Saquetti Martins Advocacia ·
        <a href="/politica-de-privacidade">Política de Privacidade</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--color-navy-deep);
    color: var(--ink-soft);
    padding: clamp(3.5rem, 7vw, 5.5rem) 0 0;
    border-top: 1px solid var(--gold-faint);
    overflow: clip;
  }
  /* padrão da marca a 6 % */
  .site-footer::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-gold-light);
    -webkit-mask: var(--pattern) repeat;
    mask: var(--pattern) repeat;
    -webkit-mask-size: 160px auto;
    mask-size: 160px auto;
    opacity: 0.06;
    pointer-events: none;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.2fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: 3rem;
  }
  .footer-logo {
    display: inline-block;
    color: var(--color-ivory);
    transition: color 0.3s ease;
  }
  .footer-logo:hover {
    color: var(--color-gold-light);
  }
  .footer-logo :global(svg) {
    width: 150px;
    height: auto;
    display: block;
  }
  .footer-brand .slogan {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 1.35rem;
    color: var(--color-gold-light);
    max-width: 20rem;
    line-height: 1.35;
    margin-top: 1.4rem;
  }
  .footer-brand .oab {
    font-size: 0.8125rem;
    margin-top: 0.8rem;
    color: var(--ink-soft);
  }
  .footer-col :global(.eyebrow) {
    margin-bottom: 1.4rem;
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-col li {
    margin-bottom: 0.7rem;
  }
  .footer-col a {
    font-size: 0.9375rem;
    color: var(--ink-soft);
    transition: color 0.3s ease;
  }
  .footer-col a:hover {
    color: var(--color-gold-light);
  }
  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }
  .footer-contact li {
    margin-bottom: 1rem;
  }
  .footer-contact .lbl {
    display: block;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .footer-contact .ic {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--color-gold-mid);
    color: var(--color-gold-light);
  }
  .footer-contact .ic :global(svg) {
    width: 16px;
    height: 16px;
  }
  .footer-contact .place {
    font-size: 0.875rem;
    color: var(--ink-soft);
    margin-top: 0.4rem;
  }

  .footer-bottom {
    position: relative;
    border-top: 1px solid var(--ivory-line);
    padding: 1.5rem 0 2rem;
  }
  .footer-bottom-in {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2.5rem;
    justify-content: space-between;
    align-items: center;
  }
  .footer-bottom p {
    font-size: 0.75rem;
    color: var(--ink-soft);
    letter-spacing: 0.03em;
  }
  .footer-bottom a {
    color: var(--color-ivory);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.3s ease;
  }
  .footer-bottom a:hover {
    color: var(--color-gold-light);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
