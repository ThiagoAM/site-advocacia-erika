---
/**
 * Hero compacto (navy) das páginas internas — breadcrumb, overline,
 * h1 único da página e lead opcional. Ecoa o tema "Estrutura Arquitetônica".
 */
export interface Crumb {
  label: string;
  href?: string;
}

import { Image } from 'astro:assets';

interface Props {
  tag: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  /** Foto ambiente (3:2) exibida à direita, atrás de um degradê navy */
  image?: ImageMetadata;
}

const { tag, title, lead, crumbs = [], image } = Astro.props;
---

<section class:list={['section', 'page-hero', 'grid-navy', { 'has-image': !!image }]}>
  {
    image && (
      <div class="hero-img" aria-hidden="true">
        <Image
          src={image}
          alt=""
          widths={[720, 1080, 1536]}
          sizes="(max-width: 860px) 100vw, 70vw"
          format="webp"
          quality={78}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }
  <div class="container">
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Trilha de navegação">
          <ol>
            {crumbs.map((crumb) => (
              <li>
                {crumb.href ? (
                  <a href={crumb.href}>{crumb.label}</a>
                ) : (
                  <span aria-current="page">{crumb.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <span class="sec-tag">{tag}</span>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <div class="rule-double"></div>
  </div>
</section>

<style>
  .page-hero {
    padding: calc(var(--header-h) + clamp(3rem, 6.5vw, 5rem)) 0 clamp(3rem, 6vw, 4.5rem);
    background: linear-gradient(165deg, var(--color-navy) 0%, var(--color-navy-deep) 92%);
    color: var(--color-ivory);
  }
  .page-hero.has-image {
    min-height: clamp(420px, 52vw, 560px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .page-hero.has-image .container {
    width: min(1180px, 92%);
  }
  .hero-img {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }
  /* véu navy: sólido à esquerda (texto), translúcido à direita (foto) */
  .hero-img::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, var(--color-navy) 0%, var(--color-navy) 28%, rgba(4, 30, 66, 0.82) 52%, rgba(4, 30, 66, 0.45) 100%),
      linear-gradient(0deg, rgba(3, 23, 51, 0.75) 0%, rgba(3, 23, 51, 0) 45%);
  }
  @media (max-width: 860px) {
    .hero-img::after {
      background: linear-gradient(0deg, var(--color-navy) 0%, rgba(4, 30, 66, 0.78) 45%, rgba(4, 30, 66, 0.3) 100%);
    }
  }

  .crumbs {
    margin-bottom: clamp(1.8rem, 3.5vw, 2.6rem);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .crumbs li + li::before {
    content: "/";
    color: var(--color-gold);
  }
  .crumbs a {
    color: var(--ivory-soft);
    transition: color 0.3s ease;
  }
  .crumbs a:hover {
    color: var(--color-gold);
  }
  .crumbs span[aria-current] {
    color: var(--color-gold);
  }

  .page-hero h1 {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    color: var(--color-ivory);
    max-width: 24ch;
  }
  .page-hero .lead {
    margin-top: 1.3rem;
    font-weight: 400;
    color: var(--ivory-soft);
    max-width: 40rem;
  }
</style>
