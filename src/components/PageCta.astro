---
/**
 * CTA de encerramento das páginas internas (v3): centrado, halo dourado em CSS,
 * h2 com trecho em itálico dourado, botão WhatsApp com pulso e linha de canais
 * secundários (e-mail e Instagram).
 */
import Button from './ui/Button.astro';
import Eyebrow from './ui/Eyebrow.astro';
import GoldRule from './ui/GoldRule.astro';
import { EMAIL, INSTAGRAM_HANDLE, INSTAGRAM_URL, WHATSAPP_URL } from '../data/site';

interface Props {
  /** Mantido por compatibilidade (numeração antiga); não é exibido. */
  num?: string;
  title: string;
  /** Título com marcação (`<em class="em-gold">`); tem precedência sobre `title`. */
  titleHtml?: string;
  text: string;
  label?: string;
}

const { title, titleHtml, text, label = 'Falar no WhatsApp' } = Astro.props;
---

<section class="section page-cta">
  <span class="pattern-veil pattern-veil-fade" aria-hidden="true"></span>
  <span class="cta-glow" aria-hidden="true"></span>
  <div class="container">
    <Eyebrow>Contato</Eyebrow>
    {titleHtml ? <h2 set:html={titleHtml} /> : <h2>{title}</h2>}
    <p class="lead">{text}</p>
    <GoldRule />
    <div class="cta-btn">
      <Button href={WHATSAPP_URL} variant="gold" external icon="whatsapp" pulse>{label}</Button>
    </div>
    <p class="channels">
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <span class="sep" aria-hidden="true"></span>
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener">{INSTAGRAM_HANDLE}</a>
    </p>
    <p class="after">Clientes já atendidos · Brasil — EUA — Canadá — Portugal — Itália</p>
  </div>
</section>

<style>
  .page-cta {
    background: var(--bg-page);
    border-top: 1px solid var(--ivory-line);
    text-align: center;
  }
  .page-cta .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .cta-glow {
    position: absolute;
    left: 50%;
    top: 42%;
    width: min(130vw, 1000px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      50% 50% at 50% 50%,
      rgba(184, 153, 107, 0.24) 0%,
      rgba(134, 109, 75, 0.12) 34%,
      rgba(4, 30, 66, 0.1) 58%,
      rgba(1, 6, 15, 0) 74%
    );
    pointer-events: none;
    z-index: 0;
  }
  .page-cta h2 {
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    max-width: 22ch;
    text-wrap: balance;
  }
  .page-cta .lead {
    max-width: 36rem;
  }
  .cta-btn {
    margin-top: 1rem;
  }
  .channels {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .channels a {
    color: var(--color-ivory);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
    transition: color 0.3s ease;
  }
  .channels a:hover {
    color: var(--color-gold-light);
  }
  .sep {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-gold-mid);
  }
  .after {
    margin-top: 0.4rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
