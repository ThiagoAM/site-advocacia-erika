---
/**
 * Pill translúcida para flutuar sobre fotos. Slot opcional `icon` (SVG);
 * sem ícone, mostra a bolinha dourada.
 */
interface Props {
  class?: string;
  style?: string;
}
const { class: className, style } = Astro.props;
const hasIcon = Astro.slots.has('icon');
---

<span class:list={['chip', className]} style={style}>
  {
    hasIcon ? (
      <span class="chip-icon" aria-hidden="true">
        <slot name="icon" />
      </span>
    ) : (
      <span class="chip-dot" aria-hidden="true" />
    )
  }
  <span class="chip-text"><slot /></span>
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 1rem 0.6rem 0.7rem;
    border-radius: var(--radius-pill);
    background: rgba(2, 19, 43, 0.6);
    border: 1px solid rgba(251, 251, 248, 0.16);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: var(--color-ivory);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
  }
  .chip-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-gold-mid);
    box-shadow: 0 0 0 3px rgba(184, 153, 107, 0.28);
  }
  .chip-icon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--color-gold-mid);
    color: var(--color-gold-light);
  }
  .chip-icon :global(svg) {
    width: 14px;
    height: 14px;
  }
</style>
