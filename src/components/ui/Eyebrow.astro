---
/**
 * Pill de rótulo: bolinha dourada + texto uppercase. Estilo em `.eyebrow` (global.css).
 */
interface Props {
  /** Elemento renderizado (span, p, div…). */
  as?: string;
  class?: string;
}
const { as: Tag = 'span', class: className } = Astro.props;
---

<Tag class:list={['eyebrow', className]}><slot /></Tag>
