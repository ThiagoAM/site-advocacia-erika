---
import IconWhatsApp from './IconWhatsApp.astro';
import { WHATSAPP_URL } from '../data/site';
---

<section class="section hero grid-ivory">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="hero-overline">Advocacia Consultiva · Imobiliário &amp; Patrimonial</span>
        <h1>Protegendo patrimônios.<span class="l2">Construindo legados.</span></h1>
        <p class="hero-sub">
          Advocacia consultiva premium em Direito Imobiliário, Notarial e Registral e Planejamento
          Patrimonial e Sucessório — estruturas jurídicas sólidas para famílias e investidores, no
          Brasil e no exterior.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-solid" href={WHATSAPP_URL} target="_blank" rel="noopener">
            <IconWhatsApp />
            Falar no WhatsApp
          </a>
          <span class="btn-o">
            <a class="btn" href="#areas">Conheça as áreas</a>
          </span>
        </div>
      </div>

      <figure class="hero-fig" aria-hidden="true">
        <svg viewBox="0 0 400 440" fill="none" class="hero-art">
          <!-- hexágonos concêntricos -->
          <polygon class="draw hex hex-1" pathLength="1" points="200,20 373,120 373,320 200,420 27,320 27,120" stroke="#866D4B" stroke-width="1" opacity=".85"></polygon>
          <polygon class="draw hex hex-2" pathLength="1" points="200,70 330,145 330,295 200,370 70,295 70,145" stroke="#866D4B" stroke-width="1" opacity=".45"></polygon>
          <polygon class="draw hex hex-3" pathLength="1" points="200,120 287,170 287,270 200,320 113,270 113,170" stroke="#866D4B" stroke-width="1" opacity=".28"></polygon>
          <!-- estrutura isométrica (cubo) -->
          <line class="draw edge" pathLength="1" x1="200" y1="220" x2="27" y2="120" stroke="#866D4B" stroke-width="1" opacity=".55"></line>
          <line class="draw edge" pathLength="1" x1="200" y1="220" x2="373" y2="120" stroke="#866D4B" stroke-width="1" opacity=".55"></line>
          <line class="draw edge" pathLength="1" x1="200" y1="220" x2="200" y2="420" stroke="#866D4B" stroke-width="1" opacity=".55"></line>
          <!-- cotas de blueprint -->
          <line class="draw dim" pathLength="1" x1="27" y1="435" x2="373" y2="435" stroke="#041E42" stroke-width="1" opacity=".25"></line>
          <line class="draw dim" pathLength="1" x1="27" y1="430" x2="27" y2="440" stroke="#041E42" stroke-width="1" opacity=".25"></line>
          <line class="draw dim" pathLength="1" x1="373" y1="430" x2="373" y2="440" stroke="#041E42" stroke-width="1" opacity=".25"></line>
          <!-- vértices -->
          <polygon class="ripple ripple-1" points="200,120 287,170 287,270 200,320 113,270 113,170" stroke="#866D4B" stroke-width="1"></polygon>
          <polygon class="ripple ripple-2" points="200,120 287,170 287,270 200,320 113,270 113,170" stroke="#866D4B" stroke-width="1"></polygon>
          <polygon class="trace trace-1" pathLength="1" points="200,20 373,120 373,320 200,420 27,320 27,120" stroke="#C9B48C" stroke-width="2.2" stroke-linecap="round"></polygon>
          <polygon class="trace trace-2" pathLength="1" points="200,70 330,145 330,295 200,370 70,295 70,145" stroke="#C9B48C" stroke-width="1.8" stroke-linecap="round"></polygon>
          <circle class="vertex" cx="200" cy="20" r="2.5" fill="#866D4B"></circle>
          <circle class="vertex" cx="200" cy="420" r="2.5" fill="#866D4B"></circle>
          <circle class="vertex vertex-core" cx="200" cy="220" r="2.5" fill="#866D4B"></circle>
        </svg>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(3.5rem, 8vw, 6.5rem));
    padding-bottom: clamp(4rem, 8vw, 6.5rem);
    background: var(--color-ivory);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 3rem;
    align-items: center;
  }
  .hero-overline {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 2rem;
  }
  .hero-overline::before {
    content: "";
    width: 34px;
    height: 5px;
    border-top: 1px solid var(--color-gold);
    border-bottom: 1px solid var(--color-gold);
  }

  .hero h1 {
    font-size: clamp(2.3rem, 4.8vw, 3.8rem);
    color: var(--color-navy);
    margin-bottom: 1.8rem;
  }
  .hero h1 .l2 {
    color: var(--color-gold);
    display: block;
  }

  .hero-sub {
    max-width: 34rem;
    font-size: 1.06rem;
    font-weight: 400;
    color: var(--ink-soft);
    margin-bottom: 2.6rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .hero-fig {
    position: relative;
    display: flex;
    justify-content: center;
    margin: 0;
  }
  .hero-fig svg {
    width: min(100%, 380px);
    height: auto;
    display: block;
  }

  /* ---- Animação: estado inicial só é definido quando a animação está ativa ---- */
  @media (prefers-reduced-motion: no-preference) {
    .hero-art {
      transform-origin: center;
      /* camada 3D já existe desde o início: evita re-rasterização quando o giro começa */
      transform: perspective(1100px) rotateY(0deg);
      will-change: transform;
      backface-visibility: hidden;
      animation: hero-turn 16s ease-in-out 2.6s infinite;
    }
    .hero-art .ripple {
      transform-box: fill-box;
      transform-origin: center;
      opacity: 0;
      animation: hero-ripple 7s cubic-bezier(0.16, 1, 0.3, 1) 3s infinite;
    }
    .hero-art .ripple-2 {
      animation-delay: 6.5s;
    }
    .hero-art .trace {
      opacity: 0;
      stroke-dasharray: 0.22 0.78;
      stroke-dashoffset: 0;
      animation:
        hero-trace-in 2s ease-in-out 2.6s forwards,
        hero-trace 9s linear 2.4s infinite;
    }
    .hero-art .trace-2 {
      stroke-dasharray: 0.16 0.84;
      animation-duration: 1.2s, 12s;
      animation-delay: 3s, 3s;
      animation-direction: normal, reverse;
    }
    .hero-art .draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: hero-draw 1.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .hero-art .hex-1 { animation-delay: 0.1s; }
    .hero-art .hex-2 { animation-delay: 0.35s; }
    .hero-art .hex-3 { animation-delay: 0.6s; }
    .hero-art .edge  { animation-delay: 0.85s; }
    .hero-art .dim   { animation-delay: 1.1s; animation-duration: 1.2s; }

    .hero-art .hex-3,
    .hero-art .edge {
      animation-name: hero-draw, hero-breathe;
      animation-duration: 1.6s, 7s;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1), ease-in-out;
      animation-iteration-count: 1, infinite;
      animation-fill-mode: both, none;
    }
    .hero-art .hex-3 { --o: 0.28; animation-delay: 0.6s, 2.4s; }
    .hero-art .edge  { --o: 0.55; animation-delay: 0.85s, 2.8s; }

    .hero-art .vertex {
      transform-box: fill-box;
      transform-origin: center;
      animation: hero-vertex-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) 1.3s both;
    }
    .hero-art .vertex-core {
      animation: hero-vertex-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) 1.3s both,
        hero-pulse 6s ease-in-out 2.4s infinite;
    }
  }

  @keyframes hero-draw {
    from { stroke-dashoffset: 1; }
    to   { stroke-dashoffset: 0; }
  }
  .hero-art .trace {
    opacity: 0;
  }
  .hero-art .ripple {
    opacity: 0;
  }
  /* parte e volta da posição neutra: sem salto ao iniciar o loop */
  @keyframes hero-turn {
    0%, 100% { transform: perspective(1100px) rotateY(0deg) rotateX(0deg) translateY(0); }
    25% { transform: perspective(1100px) rotateY(16deg) rotateX(-4deg) translateY(-8px); }
    75% { transform: perspective(1100px) rotateY(-16deg) rotateX(4deg) translateY(-4px); }
  }
  @keyframes hero-ripple {
    0% { transform: scale(1); opacity: 0; }
    18% { opacity: 0.55; }
    100% { transform: scale(2.0); opacity: 0; }
  }
  @keyframes hero-trace {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes hero-trace-in {
    to { opacity: 1; }
  }
  @keyframes hero-float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
  }
  @keyframes hero-breathe {
    0%, 100% { opacity: var(--o, 1); }
    50%      { opacity: calc(var(--o, 1) * 0.55); }
  }
  @keyframes hero-vertex-in {
    from { opacity: 0; transform: scale(0.4); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes hero-pulse {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.6); }
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-fig {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .hero-ctas :global(.btn),
    .hero-ctas .btn-o {
      width: 100%;
    }
  }
</style>
