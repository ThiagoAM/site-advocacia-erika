---
/**
 * Monograma "SM" dentro de contorno hexagonal fino dourado.
 * Placeholder — será substituído pelo SVG oficial da marca.
 */
interface Props {
  /** Cor do monograma (navy sobre fundos claros, marfim sobre navy). */
  textColor?: string;
  width?: number;
  height?: number;
  strokeWidth?: number;
}
const { textColor = '#041E42', width = 42, height = 46, strokeWidth = 1 } = Astro.props;
---

<svg width={width} height={height} viewBox="0 0 40 44" aria-hidden="true">
  <polygon
    points="20,1.5 37.5,11.75 37.5,32.25 20,42.5 2.5,32.25 2.5,11.75"
    fill="none"
    stroke="#866D4B"
    stroke-width={strokeWidth}
  ></polygon>
  <text
    x="20"
    y="27.5"
    text-anchor="middle"
    font-family="Italiana, Georgia, serif"
    font-size="14"
    letter-spacing="1"
    fill={textColor}>SM</text
  >
</svg>

<style>
  svg {
    display: block;
    flex: none;
  }
</style>
