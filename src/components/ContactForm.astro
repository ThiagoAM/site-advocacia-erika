---
/**
 * Formulário de contato — Web3Forms (https://web3forms.com).
 *
 * Sem backend próprio: o POST vai direto para a API do Web3Forms, que
 * encaminha a mensagem para o e-mail cadastrado na access key.
 * Progressive enhancement: sem JS o <form> faz o POST normal; com JS
 * o envio é via fetch e o resultado aparece inline.
 *
 * Sem PUBLIC_WEB3FORMS_KEY no build, o formulário continua visível em modo
 * degradado: o envio abre o aplicativo de e-mail do visitante com a mensagem
 * preenchida (mailto). Com a chave, envia pela API do Web3Forms.
 *
 * Apresentação (v2): seção navy com cabeça de seção; o formulário fica sobre
 * um card MARFIM — o único bloco claro do site — para legibilidade dos campos.
 * Os tokens de texto (`--ink-*`) são redefinidos localmente dentro do card.
 */
import SectionHead from './ui/SectionHead.astro';
import GlassCard from './ui/GlassCard.astro';
import Button from './ui/Button.astro';
import { areas } from '../data/areas';
import { EMAIL, SITE_NAME, WHATSAPP_URL } from '../data/site';

interface Props {
  /** Mantido por compatibilidade (numeração antiga); não é exibido. */
  num?: string;
}

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const hasKey = accessKey.trim().length > 0;

const assuntos = [...areas.map((a) => a.titulo), 'Educação & Treinamentos', 'Outro'];
---

<section class="section section-navy-deep mensagem" id="mensagem" data-mode={hasKey ? 'api' : 'mailto'} data-email={EMAIL}>
  <div class="container">
    <SectionHead
      eyebrow="Envie uma mensagem"
      align="left"
      lead="Descreva brevemente a situação e o melhor canal para retorno. As mensagens são lidas pela própria advogada e respondidas em dias úteis, na ordem de chegada."
    >
      Prefere escrever? <em class="em-gold">Conte-nos o seu caso</em>.
    </SectionHead>

    <div class="form-wrap">
      <div class="form-card">
        <form
          id="contact-form"
          class="contact-form"
          method="POST"
          action={hasKey ? 'https://api.web3forms.com/submit' : `mailto:${EMAIL}`}
          enctype={hasKey ? undefined : 'text/plain'}
        >
          {hasKey && <input type="hidden" name="access_key" value={accessKey} />}
          <input type="hidden" name="subject" value={`Novo contato pelo site — ${SITE_NAME}`} />
          <input type="hidden" name="from_name" value={`Site ${SITE_NAME}`} />
          {/* honeypot anti-spam (Web3Forms) — invisível para pessoas */}
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="grid">
            <div class="field">
              <label for="cf-nome">Nome <span class="req" aria-hidden="true">*</span></label>
              <input id="cf-nome" name="name" type="text" required autocomplete="name" placeholder="Seu nome completo" />
            </div>

            <div class="field">
              <label for="cf-email">E-mail <span class="req" aria-hidden="true">*</span></label>
              <input id="cf-email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="voce@exemplo.com" />
            </div>

            <div class="field">
              <label for="cf-telefone">Telefone / WhatsApp <span class="opt">opcional</span></label>
              <input id="cf-telefone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+55 (41) 9 9999-9999" />
            </div>

            <div class="field">
              <label for="cf-assunto">Assunto <span class="req" aria-hidden="true">*</span></label>
              <div class="select-wrap">
                <select id="cf-assunto" name="assunto" required autocomplete="off">
                  <option value="" selected disabled>Selecione uma área</option>
                  {assuntos.map((a) => (
                    <option value={a}>{a}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="field span-2">
              <label for="cf-mensagem">Mensagem <span class="req" aria-hidden="true">*</span></label>
              <textarea id="cf-mensagem" name="message" required rows="6" minlength="10" autocomplete="off" placeholder="Conte, em poucas linhas, o que você precisa." />
            </div>

            <div class="field span-2 consent">
              <input id="cf-lgpd" name="consentimento_lgpd" type="checkbox" required value="sim" />
              <label for="cf-lgpd">
                Li e concordo com a <a href="/politica-de-privacidade/">Política de Privacidade</a> e autorizo o
                uso dos dados informados exclusivamente para retorno deste contato.
                <span class="req" aria-hidden="true">*</span>
              </label>
            </div>
          </div>

          <div class="actions">
            <button class="btn btn-navy" type="submit" data-submit>
              <span data-submit-label>Enviar mensagem</span>
              <span class="btn-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 12h14" />
                  <path d="m12 6 6 6-6 6" />
                </svg>
              </span>
            </button>
            <p class="note">Campos marcados com * são obrigatórios. Nenhuma informação é compartilhada com terceiros.</p>
          </div>

          <p class="status" data-status aria-live="polite" />
        </form>

        <div class="success" data-success hidden>
          <span class="success-rule" aria-hidden="true" />
          <h3>Mensagem enviada.</h3>
          <p>Retornaremos em breve pelo canal informado. Se preferir, siga a conversa pelo WhatsApp.</p>
          <Button href={WHATSAPP_URL} variant="gold" external icon="whatsapp">Falar no WhatsApp</Button>
        </div>
      </div>

      <GlassCard radius="md" as="aside" class="form-aside">
        <p class="aside-tag">Atendimento</p>
        <p>
          As informações enviadas são tratadas com sigilo profissional e utilizadas apenas para
          responder ao seu contato.
        </p>
        <p>
          Em caso de urgência, o WhatsApp costuma ser o caminho mais ágil.
        </p>
        <p class="aside-email">
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </p>
      </GlassCard>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const success = form.parentElement!.querySelector<HTMLElement>('[data-success]')!;
    const idleLabel = label.textContent;
    const section = form.closest<HTMLElement>('[data-mode]')!;
    const useMailto = section.dataset.mode === 'mailto';
    const email = section.dataset.email ?? '';

    const ERRO =
      'Não foi possível enviar a mensagem agora. Tente novamente em instantes ou fale conosco pelo WhatsApp ou e-mail acima.';

    const setError = (msg: string) => {
      status.textContent = msg;
      status.setAttribute('role', 'alert');
      status.classList.add('is-error');
    };

    const clearStatus = () => {
      status.textContent = '';
      status.removeAttribute('role');
      status.classList.remove('is-error');
    };

    form.addEventListener('submit', async (e) => {
      // Deixa a validação nativa agir antes do fetch.
      if (!form.checkValidity()) {
        e.preventDefault();
        form.reportValidity();
        return;
      }
      e.preventDefault();
      clearStatus();

      if (useMailto) {
        // Sem chave do Web3Forms: abre o app de e-mail com tudo preenchido.
        const d = new FormData(form);
        const linhas = [
          `Nome: ${d.get('name') ?? ''}`,
          `E-mail: ${d.get('email') ?? ''}`,
          `Telefone: ${d.get('phone') || '—'}`,
          `Assunto: ${d.get('assunto') ?? ''}`,
          '',
          String(d.get('message') ?? ''),
        ];
        const subject = encodeURIComponent(`Contato pelo site — ${d.get('assunto') ?? ''}`);
        const body = encodeURIComponent(linhas.join('\n'));
        window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
        status.textContent =
          'Abrindo o seu aplicativo de e-mail com a mensagem preenchida. Se nada acontecer, escreva para ' + email + '.';
        return;
      }

      btn.disabled = true;
      label.textContent = 'Enviando…';

      try {
        const data = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = (await res.json().catch(() => null)) as { success?: boolean; message?: string } | null;

        if (res.ok && json?.success) {
          form.hidden = true;
          success.hidden = false;
          success.querySelector('h3')?.setAttribute('tabindex', '-1');
          (success.querySelector('h3') as HTMLElement | null)?.focus();
        } else {
          setError(ERRO);
        }
      } catch {
        setError(ERRO);
      } finally {
        btn.disabled = false;
        label.textContent = idleLabel;
      }
    });
  }
</script>

<style>
  .form-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  /* ---------- card marfim: único bloco claro do site ----------
     tokens de texto redefinidos para o fundo claro */
  .form-card {
    --ink: var(--color-navy);
    --ink-soft: rgba(4, 30, 66, 0.84);
    --ink-faint: rgba(4, 30, 66, 0.62);
    --field-border: rgba(4, 30, 66, 0.2);
    background: var(--color-ivory);
    color: var(--color-navy);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(251, 251, 248, 0.35);
    overflow: hidden;
  }
  .form-card ::selection {
    background: var(--color-gold);
    color: var(--color-ivory);
  }
  .contact-form,
  .success {
    padding: clamp(1.6rem, 3.5vw, 2.8rem);
  }

  /* honeypot: fora da tela, nunca via display:none (bots checam) */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.3rem 1.5rem;
  }
  .span-2 {
    grid-column: 1 / -1;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .field label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-navy);
  }
  .req {
    color: var(--color-gold);
  }
  .opt {
    margin-left: 0.4rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: none;
    color: var(--ink-faint);
  }

  .field input:not([type='checkbox']),
  .field select,
  .field textarea {
    width: 100%;
    font: inherit;
    font-size: 0.95rem;
    color: var(--color-navy);
    background: #ffffff;
    border: 1px solid var(--field-border);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--ink-faint);
  }
  .field textarea {
    resize: vertical;
    min-height: 9rem;
  }

  /* foco: ouro */
  .field input:not([type='checkbox']):focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px rgba(134, 109, 75, 0.25);
  }

  /* estado inválido só após interação do usuário */
  .field input:not([type='checkbox']):user-invalid,
  .field select:user-invalid,
  .field textarea:user-invalid {
    border-color: var(--color-gold);
    box-shadow: inset 0 0 0 1px var(--color-gold);
  }

  .select-wrap {
    position: relative;
  }
  .select-wrap select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: 2.6rem;
    cursor: pointer;
  }
  .select-wrap select:invalid {
    color: var(--ink-faint);
  }
  .select-wrap::after {
    content: '';
    position: absolute;
    right: 1.05rem;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 1px solid var(--color-gold);
    border-bottom: 1px solid var(--color-gold);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .consent {
    flex-direction: row;
    align-items: flex-start;
    gap: 0.8rem;
    margin-top: 0.2rem;
  }
  .consent input[type='checkbox'] {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 0.15rem;
    accent-color: var(--color-gold);
    cursor: pointer;
  }
  .consent input[type='checkbox']:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }
  .consent label {
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .consent label a {
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 3px;
  }
  .consent label a:hover {
    color: var(--color-gold);
  }

  .actions {
    margin-top: 1.9rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.6rem;
  }
  /* botão navy sobre o card marfim (ícone circular dourado) */
  .btn-navy {
    background: var(--color-navy);
    color: var(--color-ivory);
    border-color: var(--color-navy);
  }
  .btn-navy .btn-icon {
    background: var(--gold-gradient-soft);
    color: var(--color-navy);
  }
  .btn-navy:hover {
    background: var(--color-navy-soft);
    transform: translateY(-1px);
  }
  .btn-navy:focus-visible {
    outline-color: var(--color-gold);
  }
  .actions .btn[disabled] {
    opacity: 0.65;
    cursor: progress;
    transform: none;
  }
  .note {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    max-width: 26rem;
  }

  .status {
    margin-top: 1.2rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .status:empty {
    display: none;
  }
  .status.is-error {
    border-left: 2px solid var(--color-gold);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 0.6rem 0.9rem;
    color: var(--color-navy);
    background: rgba(134, 109, 75, 0.1);
  }

  /* estado de sucesso */
  .success {
    text-align: center;
    padding-block: clamp(2.8rem, 6vw, 4.5rem);
  }
  .success-rule {
    display: block;
    width: min(60%, 240px);
    height: 1px;
    margin: 0 auto 1.6rem;
    background: var(--color-gold);
  }
  .success h3 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    color: var(--color-navy);
    outline: none;
  }
  .success p {
    margin: 0.9rem auto 2rem;
    max-width: 30rem;
    color: var(--ink-soft);
  }

  /* aside (vidro, sobre navy) */
  .form-aside {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  .form-aside p + p {
    margin-top: 0.9rem;
  }
  .aside-tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-gold-light);
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--ivory-line);
    margin-bottom: 1.1rem;
  }
  .aside-email a {
    color: var(--color-ivory);
    font-weight: 500;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 3px;
  }
  .aside-email a:hover {
    color: var(--color-gold-light);
  }

  @media (max-width: 900px) {
    .form-wrap {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .actions .btn {
      width: 100%;
    }
  }
</style>
