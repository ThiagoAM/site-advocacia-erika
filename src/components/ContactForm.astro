---
/**
 * Formulário de contato — Web3Forms (https://web3forms.com).
 *
 * Sem backend próprio: o POST vai direto para a API do Web3Forms, que
 * encaminha a mensagem para o e-mail cadastrado na access key.
 * Progressive enhancement: sem JS o <form> faz o POST normal; com JS
 * o envio é via fetch e o resultado aparece inline.
 *
 * Sem PUBLIC_WEB3FORMS_KEY no build, o formulário continua visível em modo
 * degradado: o envio abre o aplicativo de e-mail do visitante com a mensagem
 * preenchida (mailto). Com a chave, envia pela API do Web3Forms.
 */
import IconWhatsApp from './IconWhatsApp.astro';
import { areas } from '../data/areas';
import { EMAIL, SITE_NAME, WHATSAPP_URL } from '../data/site';

interface Props {
  num?: string;
}

const { num = '02' } = Astro.props;

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const hasKey = accessKey.trim().length > 0;

const assuntos = [...areas.map((a) => a.titulo), 'Educação & Treinamentos', 'Outro'];
---

<section class="section mensagem grid-ivory" id="mensagem" data-mode={hasKey ? 'api' : 'mailto'} data-email={EMAIL}>
      <div class="container">
        <div class="sec-head">
          <span class="sec-tag">
            <span class="num">{num}</span>
            <span class="bar">/</span>Envie uma mensagem
          </span>
          <h2>Prefere escrever? Conte-nos o seu caso.</h2>
          <div class="rule-double" />
          <p class="lead">
            Descreva brevemente a situação e o melhor canal para retorno. As mensagens são lidas
            pela própria advogada e respondidas em dias úteis, na ordem de chegada.
          </p>
        </div>

        <div class="form-wrap">
            <div class="form-card">
              <form
                id="contact-form"
                class="contact-form"
                method="POST"
                action={hasKey ? 'https://api.web3forms.com/submit' : `mailto:${EMAIL}`}
                enctype={hasKey ? undefined : 'text/plain'}
              >
                {hasKey && <input type="hidden" name="access_key" value={accessKey} />}
                <input type="hidden" name="subject" value={`Novo contato pelo site — ${SITE_NAME}`} />
                <input type="hidden" name="from_name" value={`Site ${SITE_NAME}`} />
                {/* honeypot anti-spam (Web3Forms) — invisível para pessoas */}
                <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

                <div class="grid">
                  <div class="field">
                    <label for="cf-nome">Nome <span class="req" aria-hidden="true">*</span></label>
                    <input id="cf-nome" name="name" type="text" required autocomplete="name" placeholder="Seu nome completo" />
                  </div>

                  <div class="field">
                    <label for="cf-email">E-mail <span class="req" aria-hidden="true">*</span></label>
                    <input id="cf-email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="voce@exemplo.com" />
                  </div>

                  <div class="field">
                    <label for="cf-telefone">Telefone / WhatsApp <span class="opt">opcional</span></label>
                    <input id="cf-telefone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+55 (41) 9 9999-9999" />
                  </div>

                  <div class="field">
                    <label for="cf-assunto">Assunto <span class="req" aria-hidden="true">*</span></label>
                    <div class="select-wrap">
                      <select id="cf-assunto" name="assunto" required autocomplete="off">
                        <option value="" selected disabled>Selecione uma área</option>
                        {assuntos.map((a) => (
                          <option value={a}>{a}</option>
                        ))}
                      </select>
                    </div>
                  </div>

                  <div class="field span-2">
                    <label for="cf-mensagem">Mensagem <span class="req" aria-hidden="true">*</span></label>
                    <textarea id="cf-mensagem" name="message" required rows="6" minlength="10" autocomplete="off" placeholder="Conte, em poucas linhas, o que você precisa." />
                  </div>

                  <div class="field span-2 consent">
                    <input id="cf-lgpd" name="consentimento_lgpd" type="checkbox" required value="sim" />
                    <label for="cf-lgpd">
                      Li e concordo com a <a href="/politica-de-privacidade/">Política de Privacidade</a> e autorizo o
                      uso dos dados informados exclusivamente para retorno deste contato.
                      <span class="req" aria-hidden="true">*</span>
                    </label>
                  </div>
                </div>

                <div class="actions">
                  <button class="btn btn-solid" type="submit" data-submit>
                    <span data-submit-label>Enviar mensagem</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                      <path d="M4 12h15" />
                      <path d="m13 6 6 6-6 6" />
                    </svg>
                  </button>
                  <p class="note">Campos marcados com * são obrigatórios. Nenhuma informação é compartilhada com terceiros.</p>
                </div>

                <p class="status" data-status aria-live="polite" />
              </form>

              <div class="success" data-success hidden>
                <span class="rule-double" aria-hidden="true" />
                <h3>Mensagem enviada.</h3>
                <p>Retornaremos em breve pelo canal informado. Se preferir, siga a conversa pelo WhatsApp.</p>
                <a class="btn-o" href={WHATSAPP_URL} target="_blank" rel="noopener">
                  <span class="btn">
                    <IconWhatsApp />
                    Falar no WhatsApp
                  </span>
                </a>
              </div>
            </div>

            <aside class="form-aside">
              <p class="aside-tag">Atendimento</p>
              <p>
                As informações enviadas são tratadas com sigilo profissional e utilizadas apenas para
                responder ao seu contato.
              </p>
              <p>
                Em caso de urgência, o WhatsApp costuma ser o caminho mais ágil.
              </p>
              <p class="aside-email">
                <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
              </p>
            </aside>
        </div>
      </div>
    </section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const success = form.parentElement!.querySelector<HTMLElement>('[data-success]')!;
    const idleLabel = label.textContent;
    const section = form.closest<HTMLElement>('[data-mode]')!;
    const useMailto = section.dataset.mode === 'mailto';
    const email = section.dataset.email ?? '';

    const ERRO =
      'Não foi possível enviar a mensagem agora. Tente novamente em instantes ou fale conosco pelo WhatsApp ou e-mail acima.';

    const setError = (msg: string) => {
      status.textContent = msg;
      status.setAttribute('role', 'alert');
      status.classList.add('is-error');
    };

    const clearStatus = () => {
      status.textContent = '';
      status.removeAttribute('role');
      status.classList.remove('is-error');
    };

    form.addEventListener('submit', async (e) => {
      // Deixa a validação nativa agir antes do fetch.
      if (!form.checkValidity()) {
        e.preventDefault();
        form.reportValidity();
        return;
      }
      e.preventDefault();
      clearStatus();

      if (useMailto) {
        // Sem chave do Web3Forms: abre o app de e-mail com tudo preenchido.
        const d = new FormData(form);
        const linhas = [
          `Nome: ${d.get('name') ?? ''}`,
          `E-mail: ${d.get('email') ?? ''}`,
          `Telefone: ${d.get('phone') || '—'}`,
          `Assunto: ${d.get('assunto') ?? ''}`,
          '',
          String(d.get('message') ?? ''),
        ];
        const subject = encodeURIComponent(`Contato pelo site — ${d.get('assunto') ?? ''}`);
        const body = encodeURIComponent(linhas.join('\n'));
        window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
        status.textContent =
          'Abrindo o seu aplicativo de e-mail com a mensagem preenchida. Se nada acontecer, escreva para ' + email + '.';
        return;
      }

      btn.disabled = true;
      label.textContent = 'Enviando…';

      try {
        const data = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = (await res.json().catch(() => null)) as { success?: boolean; message?: string } | null;

        if (res.ok && json?.success) {
          form.hidden = true;
          success.hidden = false;
          success.querySelector('h3')?.setAttribute('tabindex', '-1');
          (success.querySelector('h3') as HTMLElement | null)?.focus();
        } else {
          setError(ERRO);
        }
      } catch {
        setError(ERRO);
      } finally {
        btn.disabled = false;
        label.textContent = idleLabel;
      }
    });
  }
</script>

<style>
  .mensagem {
    padding: var(--pad-sec) 0;
    background: var(--color-paper);
    border-top: 1px solid var(--ink-faint);
  }

  .form-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  /* cartão chanfrado com borda de 1px (mesmo truque dos cards) */
  .form-card {
    clip-path: var(--ch);
    padding: 1px;
    background: rgba(4, 30, 66, 0.13);
  }
  .contact-form,
  .success {
    clip-path: var(--ch);
    background: var(--color-ivory);
    padding: clamp(1.6rem, 3.5vw, 2.8rem);
  }

  /* honeypot: fora da tela, nunca via display:none (bots checam) */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.3rem 1.5rem;
  }
  .span-2 {
    grid-column: 1 / -1;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .field label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-navy);
  }
  .req {
    color: var(--color-gold);
  }
  .opt {
    margin-left: 0.4rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: none;
    color: var(--gold-soft);
  }

  .field input:not([type='checkbox']),
  .field select,
  .field textarea {
    width: 100%;
    font: inherit;
    font-size: 0.95rem;
    color: var(--color-navy);
    background: var(--color-paper);
    border: 1px solid rgba(4, 30, 66, 0.2);
    border-radius: 0;
    padding: 0.85rem 1rem;
    clip-path: var(--ch-s);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: rgba(4, 30, 66, 0.4);
  }
  .field textarea {
    resize: vertical;
    min-height: 9rem;
  }

  /* foco: outline ouro — o clip-path cortaria o outline externo, então
     desenhamos por dentro com box-shadow inset + borda */
  .field input:not([type='checkbox']):focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: inset 0 0 0 1px var(--color-gold);
  }

  /* estado inválido só após interação do usuário */
  .field input:not([type='checkbox']):user-invalid,
  .field select:user-invalid,
  .field textarea:user-invalid {
    border-color: var(--color-gold);
    box-shadow: inset 0 0 0 1px var(--color-gold);
  }

  .select-wrap {
    position: relative;
  }
  .select-wrap select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: 2.6rem;
    cursor: pointer;
  }
  .select-wrap select:invalid {
    color: rgba(4, 30, 66, 0.55);
  }
  .select-wrap::after {
    content: '';
    position: absolute;
    right: 1.05rem;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 1px solid var(--color-gold);
    border-bottom: 1px solid var(--color-gold);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .consent {
    flex-direction: row;
    align-items: flex-start;
    gap: 0.8rem;
    margin-top: 0.2rem;
  }
  .consent input[type='checkbox'] {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 0.15rem;
    accent-color: var(--color-gold);
    cursor: pointer;
  }
  .consent input[type='checkbox']:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }
  .consent label {
    font-size: 0.86rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .consent label a {
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 3px;
  }
  .consent label a:hover {
    color: var(--color-gold);
  }

  .actions {
    margin-top: 1.9rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.6rem;
  }
  .actions .btn[disabled] {
    opacity: 0.65;
    cursor: progress;
    transform: none;
  }
  .note {
    font-size: 0.76rem;
    color: var(--ink-soft);
    max-width: 26rem;
  }

  .status {
    margin-top: 1.2rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .status:empty {
    display: none;
  }
  .status.is-error {
    border-left: 2px solid var(--color-gold);
    padding: 0.6rem 0.9rem;
    color: var(--color-navy);
    background: rgba(134, 109, 75, 0.08);
  }

  /* estado de sucesso */
  .success {
    text-align: center;
    padding-block: clamp(2.8rem, 6vw, 4.5rem);
  }
  .success :global(.rule-double) {
    display: block;
    margin: 0 auto 1.6rem;
  }
  .success h3 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--color-navy);
    outline: none;
  }
  .success p {
    margin: 0.9rem auto 2rem;
    max-width: 30rem;
    color: var(--ink-soft);
  }

  /* aside */
  .form-aside {
    padding-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .form-aside p + p {
    margin-top: 0.9rem;
  }
  .aside-tag {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-gold);
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--gold-faint);
    margin-bottom: 1.1rem;
  }
  .aside-email a {
    color: var(--color-navy);
    font-weight: 500;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 3px;
  }


  @media (max-width: 900px) {
    .form-wrap {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .actions .btn {
      width: 100%;
    }
  }
</style>
