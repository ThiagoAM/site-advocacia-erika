---
const itens = [
  {
    num: '/ 01',
    value: 'Desde 2009',
    label: 'Atuação contínua em advocacia consultiva e estratégica.',
  },
  {
    num: '/ 02',
    value: 'Doutora em Direito',
    label: 'Pesquisa dedicada à regularização fundiária — REURB.',
  },
  {
    num: '/ 03',
    value: '4 países',
    label: 'Brasil · Estados Unidos · Canadá · Portugal.',
  },
  {
    num: '/ 04',
    value: 'OAB/PR 52.743',
    label: 'Membro de comissões da Ordem dos Advogados do Brasil.',
  },
];
---

<section class="section cred grid-navy" aria-label="Credenciais">
  <div class="container">
    <div class="cred-grid">
      {
        itens.map((item) => (
          <div class="cred-item">
            <span class="num">{item.num}</span>
            <span class="value">{item.value}</span>
            <span class="label">{item.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cred {
    background: var(--color-navy);
    color: var(--color-ivory);
    padding: clamp(2.8rem, 5vw, 3.8rem) 0;
  }
  .cred-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .cred-item {
    padding: 0 2rem;
    border-left: 1px solid var(--gold-faint);
  }
  .cred-item:first-child {
    border-left: none;
    padding-left: 0;
  }
  .cred-item .num {
    display: block;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: var(--gold-text);
    margin-bottom: 0.7rem;
  }
  .cred-item .value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    color: var(--color-ivory);
    line-height: 1.1;
    margin-bottom: 0.45rem;
  }
  .cred-item .label {
    display: block;
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--ivory-soft);
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .cred-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.2rem 0;
    }
    .cred-item:nth-child(3) {
      border-left: none;
      padding-left: 0;
    }
  }

  @media (max-width: 600px) {
    .cred-grid {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }
    .cred-item {
      border-left: none;
      padding: 0;
      border-top: 1px solid var(--gold-faint);
      padding-top: 1.4rem;
    }
    .cred-item:first-child {
      border-top: none;
      padding-top: 0;
    }
  }
</style>
