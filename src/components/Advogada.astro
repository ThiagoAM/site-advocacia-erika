---
import { Image } from 'astro:assets';
import portraitImg from '../assets/img/portrait-ambiente.png';
import { WHATSAPP_URL } from '../data/site';
---

<section class="section advogada grid-navy" id="advogada">
  <div class="container">
    <div class="adv-grid">
      <div
        class="portrait"
        role="img"
        aria-label="Retrato da Dra. Érika Silvana Saquetti Martins (imagem ilustrativa)"
      >
        <Image
          class="portrait-img"
          src={portraitImg}
          alt=""
          widths={[480, 720, 1024]}
          sizes="(max-width: 860px) 92vw, 40vw"
          format="webp"
          quality={80}
        />
        <div class="portrait-caption">
          <p class="name">Dra. Érika Silvana Saquetti Martins</p>
          <p class="role">Advogada · OAB/PR</p>
        </div>
      </div>

      <div class="adv-copy">
        <span class="sec-tag"><span class="num">02</span><span class="bar">/</span>A Advogada</span>
        <h2>Rigor acadêmico. Prática de quem constrói.</h2>
        <p class="bio">
          Advogada desde 2009, a Dra. Érika Silvana Saquetti Martins dedica sua trajetória à
          proteção de patrimônios e à construção de legados. Doutora em Direito com pesquisa em
          regularização fundiária, une profundidade acadêmica e prática consultiva para entregar
          soluções seguras — a famílias e investidores no Brasil e no exterior.
        </p>

        <ul class="creds">
          <li><strong>Doutora em Direito</strong> — pesquisa em REURB</li>
          <li><strong>Mestre em Políticas Públicas</strong> — UFPR</li>
          <li><strong>Mestre em Direito</strong> — UNINTER</li>
          <li><strong>Professora</strong> de pós-graduação, palestrante e escritora</li>
          <li><strong>Membro de comissões</strong> da OAB/PR</li>
          <li><strong>Atendimento internacional</strong> — Brasil, EUA, Canadá e Portugal</li>
        </ul>

        <span class="btn-o on-navy">
          <a class="btn" href={WHATSAPP_URL} target="_blank" rel="noopener">Agendar uma conversa</a>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .advogada {
    padding: var(--pad-sec) 0;
    background: var(--color-navy);
    color: var(--color-ivory);
  }
  .adv-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .portrait {
    position: relative;
    clip-path: var(--ch);
    aspect-ratio: 4 / 5;
    background:
      repeating-linear-gradient(45deg, rgba(134, 109, 75, 0.13) 0 1px, transparent 1px 16px),
      linear-gradient(160deg, var(--color-navy-soft) 0%, var(--color-navy-deep) 78%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
  }
  .portrait .portrait-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  /* véu inferior para a legenda */
  .portrait-caption {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 4rem 1.5rem 2rem;
    background: linear-gradient(0deg, rgba(3, 23, 51, 0.92) 0%, rgba(3, 23, 51, 0.6) 60%, rgba(3, 23, 51, 0) 100%);
  }
  .portrait::before,
  .portrait::after {
    z-index: 2;
  }
  .portrait::before,
  .portrait::after {
    content: "";
    position: absolute;
    width: 30px;
    height: 30px;
  }
  .portrait::before {
    top: 16px;
    left: 16px;
    border-top: 1px solid var(--color-gold);
    border-left: 1px solid var(--color-gold);
  }
  .portrait::after {
    bottom: 16px;
    right: 16px;
    border-bottom: 1px solid var(--color-gold);
    border-right: 1px solid var(--color-gold);
  }
  .portrait-caption {
    text-align: center;
  }
  .portrait-caption .name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-ivory);
  }
  .portrait-caption .role {
    margin-top: 0.4rem;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .adv-copy h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-ivory);
    margin-bottom: 1.4rem;
  }
  .adv-copy .bio {
    font-weight: 400;
    color: var(--ivory-soft);
    margin-bottom: 2.2rem;
    max-width: 34rem;
  }
  .creds {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem 2rem;
    margin-bottom: 2.4rem;
  }
  .creds li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.88rem;
    font-weight: 400;
    color: var(--ivory-soft);
    line-height: 1.5;
  }
  .creds li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 9px;
    height: 9px;
    border: 1px solid var(--color-gold);
    transform: rotate(45deg);
  }
  .creds li strong {
    font-weight: 500;
    color: var(--color-ivory);
  }

  @media (max-width: 860px) {
    .adv-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      max-width: 420px;
      margin-inline: auto;
      width: 100%;
    }
  }
  @media (max-width: 600px) {
    .creds {
      grid-template-columns: 1fr;
    }
  }
</style>
