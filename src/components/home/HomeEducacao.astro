---
/**
 * Seção 7 — Educação & Treinamentos: card largo com texto + imagem.
 */
import { Image } from 'astro:assets';
import eduImg from '../../assets/img/v3/educacao.png';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import GlassCard from '../ui/GlassCard.astro';
import Chip from '../ui/Chip.astro';
import Reveal from '../ui/Reveal.astro';

const publicos = ['Advogados', 'Corretores', 'Investidores'];
---

<section class="section educacao section-alt section-hairline" id="educacao" aria-labelledby="edu-title">
  <div class="container">
    <Reveal>
      <GlassCard radius="lg" padding="none" class="edu-card">
        <div class="edu-copy">
          <Eyebrow>Educação &amp; Treinamentos</Eyebrow>
          <h3 id="edu-title">Conhecimento que <em class="em-gold">forma mercado</em>.</h3>
          <p>
            Cursos, mentorias e treinamentos práticos para advogados que desejam dominar o Direito
            Imobiliário e a REURB, corretores que querem negociar com segurança jurídica e
            investidores que exigem previsibilidade em cada aquisição.
          </p>
          <div class="edu-chips" aria-label="Públicos atendidos">
            {publicos.map((p) => <Chip>{p}</Chip>)}
          </div>
          <Button href="/educacao" variant="ghost">Conhecer os programas</Button>
        </div>
        <div class="edu-fig">
          <Image src={eduImg} alt="" widths={[600, 900, 1200]} sizes="(max-width: 900px) 92vw, 45vw" format="webp" quality={72} />
        </div>
      </GlassCard>
    </Reveal>
  </div>
</section>

<style>
  .edu-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    overflow: hidden;
  }
  .edu-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
    padding: clamp(2.2rem, 4.5vw, 3.5rem) clamp(1.6rem, 3.2vw, 2.8rem);
  }
  .edu-copy h3 {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    font-weight: 300;
    text-wrap: balance;
  }
  .edu-copy p {
    color: var(--ink-soft);
    max-width: 34rem;
  }
  .edu-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .edu-fig {
    position: relative;
    min-height: 320px;
    padding: 0.75rem;
  }
  .edu-fig :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 0.75rem);
  }
  @media (max-width: 900px) {
    .edu-card {
      grid-template-columns: 1fr;
    }
    .edu-fig {
      order: -1;
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
    .edu-fig :global(img) {
      position: absolute;
      inset: 0.75rem;
      width: calc(100% - 1.5rem);
      height: calc(100% - 1.5rem);
    }
  }
  @media (max-width: 600px) {
    .edu-copy :global(.btn) {
      width: 100%;
    }
  }
</style>
