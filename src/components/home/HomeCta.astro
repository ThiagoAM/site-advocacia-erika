---
/**
 * Seção final — CTA + 3 canais.
 *
 * v3: o halo dourado passou a ser um degradê radial em CSS. A imagem anterior
 * usava `mix-blend-mode: screen`, que clareava a seção inteira e destoava do
 * resto do site. Os cards de canal também estavam com larguras diferentes
 * porque o wrapper de revelação centralizava e encolhia cada um.
 */
import Button from '../ui/Button.astro';
import GlassCard from '../ui/GlassCard.astro';
import Reveal from '../ui/Reveal.astro';
import { EMAIL, INSTAGRAM_HANDLE, INSTAGRAM_URL, WHATSAPP_URL } from '../../data/site';

const canais = [
  {
    rotulo: 'E-mail',
    valor: EMAIL,
    href: `mailto:${EMAIL}`,
    external: false,
    icon: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  },
  {
    rotulo: 'Instagram',
    valor: INSTAGRAM_HANDLE,
    href: INSTAGRAM_URL,
    external: true,
    icon: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/>',
  },
  {
    rotulo: 'Formulário',
    valor: 'Escreva pelo site',
    href: '/contato#mensagem',
    external: false,
    icon: '<path d="M4 4h16v12H8l-4 4z"/><path d="M8 9h8M8 12.5h5"/>',
  },
];
---

<section class="section cta section-hairline" id="contato" aria-labelledby="cta-title">
  <span class="cta-halo" aria-hidden="true"></span>

  <div class="container cta-wrap">
    <Reveal class="cta-head">
      <h2 id="cta-title">Vamos desenhar <em class="em-gold">a estrutura do seu legado</em>?</h2>
      <p class="lead">
        Agende uma conversa e receba uma leitura técnica e humana do seu caso — em Direito
        Imobiliário, regularização de imóveis ou planejamento patrimonial e sucessório.
      </p>
      <div class="cta-action">
        <Button href={WHATSAPP_URL} variant="gold" external icon="whatsapp" pulse>Agendar consulta no WhatsApp</Button>
      </div>
      <p class="cta-note">Atendimento · Brasil — EUA — Canadá — Portugal — Itália</p>
    </Reveal>

    <ul class="canais" aria-label="Outros canais de contato">
      {
        canais.map((c, i) => (
          <li>
            <Reveal delay={200 + i * 90} class="canal-reveal">
              <GlassCard
                as="a"
                radius="md"
                padding="sm"
                class="canal"
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener' : undefined}
              >
                <span class="canal-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <Fragment set:html={c.icon} />
                  </svg>
                </span>
                <span class="canal-txt">
                  <span class="canal-rotulo">{c.rotulo}</span>
                  <span class="canal-valor">{c.valor}</span>
                </span>
              </GlassCard>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cta {
    background: var(--bg-page);
  }
  /* halo em CSS: escurece nas bordas até o fundo da página, sem blend-mode */
  .cta-halo {
    position: absolute;
    z-index: 0;
    left: 50%;
    top: 34%;
    width: min(1000px, 150%);
    aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      50% 50% at 50% 50%,
      rgba(184, 153, 107, 0.26) 0%,
      rgba(134, 109, 75, 0.13) 34%,
      rgba(4, 30, 66, 0.1) 58%,
      rgba(1, 6, 15, 0) 74%
    );
    pointer-events: none;
  }

  .cta-wrap {
    max-width: 1020px;
  }
  /* head e cards são blocos independentes: nada encolhe por causa do wrapper */
  .cta-wrap :global(.cta-head) {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.4rem;
  }
  .cta-wrap h2 {
    text-wrap: balance;
    max-width: 20ch;
  }
  .cta-wrap .lead {
    max-width: 40rem;
  }
  .cta-action {
    margin-top: 0.4rem;
    display: flex;
    justify-content: center;
    width: 100%;
  }
  .cta-note {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .canais {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .canais li {
    display: flex;
    min-width: 0;
  }
  /* o wrapper de revelação precisa ocupar a célula inteira da grade —
     sem isto cada card ficava com a largura do próprio texto */
  .canais :global(.canal-reveal) {
    display: flex;
    width: 100%;
    min-width: 0;
  }
  .canal {
    display: flex;
    align-items: center;
    gap: 0.95rem;
    width: 100%;
    min-width: 0;
    text-align: left;
    text-decoration: none;
    transition:
      border-color 0.3s ease,
      transform 0.3s var(--ease-out);
  }
  .canal:hover {
    border-color: var(--card-border-hover);
    transform: translateY(-2px);
  }
  .canal-icon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--gold-gradient);
    color: #06122a;
  }
  .canal-icon svg {
    width: 19px;
    height: 19px;
  }
  .canal-txt {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .canal-rotulo {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-light);
  }
  .canal-valor {
    color: var(--color-ivory);
    font-size: 0.875rem;
    line-height: 1.35;
    /* e-mails longos quebram dentro do card em vez de estourar a coluna */
    overflow-wrap: anywhere;
  }

  @media (max-width: 900px) {
    .canais {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .cta-action :global(.btn) {
      width: 100%;
    }
  }
</style>
