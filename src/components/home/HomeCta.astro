---
/**
 * Seção 11 — CTA final + 3 canais. Glow dourado ao fundo.
 */
import { Image } from 'astro:assets';
import glow from '../../assets/img/glow-gold.png';
import Button from '../ui/Button.astro';
import GlassCard from '../ui/GlassCard.astro';
import Reveal from '../ui/Reveal.astro';
import { EMAIL, INSTAGRAM_HANDLE, INSTAGRAM_URL, WHATSAPP_URL } from '../../data/site';

const canais = [
  {
    rotulo: 'E-mail',
    valor: EMAIL,
    href: `mailto:${EMAIL}`,
    external: false,
    icon: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  },
  {
    rotulo: 'Instagram',
    valor: INSTAGRAM_HANDLE,
    href: INSTAGRAM_URL,
    external: true,
    icon: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/>',
  },
  {
    rotulo: 'Formulário',
    valor: 'Escreva pelo site',
    href: '/contato#mensagem',
    external: false,
    icon: '<path d="M4 4h16v12H8l-4 4z"/><path d="M8 9h8M8 12.5h5"/>',
  },
];
---

<section class="section cta section-navy-deep" id="contato" aria-labelledby="cta-title">
  <Image class="cta-glow" src={glow} alt="" widths={[800, 1024]} sizes="900px" format="webp" quality={60} />
  <div class="container cta-wrap">
    <Reveal>
      <h2 id="cta-title">Vamos desenhar <em class="em-gold">a estrutura do seu legado</em>?</h2>
    </Reveal>
    <Reveal delay={120}>
      <p class="lead">
        Agende uma conversa e receba uma leitura técnica e humana do seu caso — em Direito
        Imobiliário, regularização de imóveis ou planejamento patrimonial e sucessório.
      </p>
    </Reveal>
    <Reveal delay={240}>
      <Button href={WHATSAPP_URL} variant="gold" external icon="whatsapp" pulse>Agendar consulta no WhatsApp</Button>
      <p class="cta-note">Atendimento · Brasil — EUA — Canadá — Portugal</p>
    </Reveal>

    <ul class="canais" aria-label="Outros canais de contato">
      {
        canais.map((c, i) => (
          <li>
            <Reveal delay={300 + i * 90}>
              <GlassCard
                as="a"
                radius="sm"
                padding="sm"
                class="canal"
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener' : undefined}
              >
                <span class="canal-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <Fragment set:html={c.icon} />
                  </svg>
                </span>
                <span class="canal-txt">
                  <span class="canal-rotulo">{c.rotulo}</span>
                  <span class="canal-valor">{c.valor}</span>
                </span>
              </GlassCard>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cta-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 0;
    width: min(900px, 140vw);
    height: auto;
    transform: translate(-50%, -55%);
    mix-blend-mode: screen;
    opacity: 0.85;
    pointer-events: none;
  }
  .cta-wrap {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.5rem;
    max-width: 880px;
  }
  .cta-wrap :global([data-reveal]) {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }
  .cta-wrap h2 {
    text-wrap: balance;
  }
  .cta-wrap .lead {
    max-width: 38rem;
  }
  .cta-note {
    margin-top: 1.2rem;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .canais {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .canais :global([data-reveal]) {
    height: 100%;
  }
  .canal {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    text-align: left;
    text-decoration: none;
    min-width: 0;
    transition: border-color 0.3s ease;
  }
  .canal:hover {
    border-color: rgba(217, 194, 154, 0.4);
  }
  .canal-icon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--gold-gradient);
    color: var(--color-navy);
  }
  .canal-icon svg {
    width: 20px;
    height: 20px;
  }
  .canal-txt {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .canal-rotulo {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-light);
  }
  .canal-valor {
    color: var(--color-ivory);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  @media (max-width: 860px) {
    .canais {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .cta-wrap :global(.btn) {
      width: 100%;
    }
  }
</style>
