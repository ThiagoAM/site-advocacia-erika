---
/**
 * Seção 8 — Notícias: 3 cards placeholder (serão substituídos pelo pipeline de notícias).
 */
import SectionHead from '../ui/SectionHead.astro';
import GlassCard from '../ui/GlassCard.astro';
import Reveal from '../ui/Reveal.astro';

const noticias = [
  {
    fonte: 'Migalhas',
    data: '18 ago 2026',
    titulo: 'STJ consolida tese sobre usucapião extrajudicial e amplia a segurança dos registros',
    href: '/noticias',
  },
  {
    fonte: 'Agência Brasil',
    data: '17 ago 2026',
    titulo: 'REURB-S: novo decreto simplifica a regularização fundiária em núcleos urbanos consolidados',
    href: '/noticias',
  },
  {
    fonte: 'Valor Econômico',
    data: '16 ago 2026',
    titulo: 'Holdings familiares avançam como estratégia de sucessão patrimonial no Brasil',
    href: '/noticias',
  },
];
---

<section class="section noticias section-navy-deep" id="noticias">
  <div class="container">
    <Reveal>
      <SectionHead eyebrow="Notícias & Conteúdo" lead="Uma seleção diária do que se move no Direito Imobiliário, Notarial, Registral e Sucessório.">
        O direito em movimento, <em class="em-gold">lido com precisão</em>.
      </SectionHead>
    </Reveal>
    <div class="news-grid">
      {
        noticias.map((n, i) => (
          <Reveal delay={i * 100}>
            <GlassCard as="article" radius="md" class="news-card">
              <p class="news-meta">
                <span class="news-fonte">{n.fonte}</span>
                <span class="news-sep" aria-hidden="true" />
                <time>{n.data}</time>
              </p>
              <h3>
                <a href={n.href}>{n.titulo}</a>
              </h3>
              <span class="news-more" aria-hidden="true">Ler análise →</span>
            </GlassCard>
          </Reveal>
        ))
      }
    </div>
    <Reveal>
      <p class="news-all">
        <a href="/noticias">Ver todas as notícias <span aria-hidden="true">→</span></a>
      </p>
    </Reveal>
  </div>
</section>

<style>
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .news-grid :global([data-reveal]),
  .news-card {
    height: 100%;
  }
  .news-card {
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s ease;
  }
  .news-card:has(a:hover) {
    border-color: rgba(217, 194, 154, 0.4);
  }
  .news-meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .news-fonte {
    color: var(--color-gold-light);
  }
  .news-sep {
    width: 18px;
    height: 1px;
    background: var(--gold-line);
  }
  .news-card h3 {
    font-size: 1.45rem;
    line-height: 1.3;
    margin-top: 1rem;
    flex: 1;
  }
  .news-card h3 a {
    color: inherit;
    text-decoration: none;
  }
  .news-card h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .news-card h3 a:hover {
    color: var(--color-gold-light);
  }
  .news-more {
    display: inline-block;
    margin-top: 1.4rem;
    color: var(--color-gold-light);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .news-all {
    text-align: center;
    margin-top: 2.5rem;
  }
  .news-all a {
    color: var(--color-gold-light);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--gold-line);
    padding-bottom: 2px;
  }
  .news-all a:hover {
    border-color: var(--color-gold-light);
  }
  @media (max-width: 900px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
