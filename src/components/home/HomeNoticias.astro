---
/**
 * Seção 8 — Notícias: 3 mais recentes do feed (ver docs/noticias-pipeline.md).
 */
import SectionHead from '../ui/SectionHead.astro';
import GlassCard from '../ui/GlassCard.astro';
import Reveal from '../ui/Reveal.astro';
import { getNoticias, formatarDataNoticia } from '../../data/noticias';

const { noticias } = await getNoticias();
const destaques = noticias.slice(0, 3);
---

<section class="section noticias section-hairline" id="noticias">
  <div class="container">
    <Reveal>
      <SectionHead eyebrow="Notícias & Conteúdo" lead="Uma seleção diária do que se move no Direito Imobiliário, Notarial, Registral e Sucessório.">
        O direito em movimento, <em class="em-gold">lido com precisão</em>.
      </SectionHead>
    </Reveal>
    {
      destaques.length > 0 ? (
        <div class="news-grid">
          {destaques.map((n, i) => (
            <Reveal delay={i * 100}>
              <GlassCard as="article" radius="md" class="news-card">
                <p class="news-meta">
                  <span class="news-fonte">{n.fonte}</span>
                  <span class="news-sep" aria-hidden="true" />
                  <time datetime={n.data_publicacao}>{formatarDataNoticia(n.data_publicacao)}</time>
                </p>
                <h3>
                  <a
                    href={n.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${n.titulo} — abre em nova aba`}
                  >
                    {n.titulo}
                  </a>
                </h3>
                <p class="news-desc">{n.descricao}</p>
                <span class="news-more" aria-hidden="true">Ler na fonte →</span>
              </GlassCard>
            </Reveal>
          ))}
        </div>
      ) : (
        <Reveal>
          <p class="news-empty">
            A curadoria de hoje está em atualização. Volte em instantes para ver a seleção do dia.
          </p>
        </Reveal>
      )
    }
    <Reveal>
      <p class="news-all">
        <a href="/noticias">Ver todas as notícias <span aria-hidden="true">→</span></a>
      </p>
    </Reveal>
  </div>
</section>

<style>
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .news-grid :global([data-reveal]),
  .news-card {
    height: 100%;
  }
  .news-card {
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s ease;
  }
  .news-card:has(a:hover) {
    border-color: rgba(217, 194, 154, 0.4);
  }
  .news-meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .news-fonte {
    color: var(--color-gold-light);
  }
  .news-sep {
    width: 18px;
    height: 1px;
    background: var(--gold-line);
  }
  .news-card h3 {
    font-size: 1.45rem;
    line-height: 1.3;
    margin-top: 1rem;
  }
  .news-card h3 a {
    color: inherit;
    text-decoration: none;
  }
  .news-card h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .news-card h3 a:hover {
    color: var(--color-gold-light);
  }
  .news-desc {
    flex: 1;
    margin-top: 0.85rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .news-more {
    display: inline-block;
    margin-top: 1.4rem;
    color: var(--color-gold-light);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .news-empty {
    max-width: 34rem;
    margin-inline: auto;
    text-align: center;
    color: var(--ink-soft);
  }
  .news-all {
    text-align: center;
    margin-top: 2.5rem;
  }
  .news-all a {
    display: inline-block;
    padding: 0.45rem 0.2rem;
    color: var(--color-gold-light);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--gold-line);
  }
  .news-all a:hover {
    border-color: var(--color-gold-light);
  }
  @media (max-width: 900px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
