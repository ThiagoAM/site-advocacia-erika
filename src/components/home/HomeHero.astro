---
/**
 * Seção 1 — Hero da home (v3).
 * Fundo: fotografia arquitetônica escura + halo dourado em CSS + grão.
 * O padrão em mosaico da v2 saiu: no lugar entram profundidade e luz.
 */
import { Image } from 'astro:assets';
import heroBg from '../../assets/img/v3/hero-bg.png';
import portrait from '../../assets/img/erika.jpg';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Chip from '../ui/Chip.astro';
import Reveal from '../ui/Reveal.astro';
import { OAB, WHATSAPP_URL } from '../../data/site';
---

<section class="section hero grain" aria-labelledby="hero-title">
  <div class="hero-bg-wrap" aria-hidden="true">
    <Image
      class="hero-bg"
      src={heroBg}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      format="webp"
      quality={72}
      loading="eager"
      fetchpriority="high"
    />
    <span class="hero-veil-l"></span>
    <span class="hero-veil-b"></span>
  </div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <Reveal>
        <Eyebrow>Advocacia consultiva · Imobiliário &amp; Patrimonial</Eyebrow>
      </Reveal>
      <Reveal delay={110}>
        <h1 id="hero-title">Protegendo patrimônios.<br /><em class="em-gold">Construindo legados.</em></h1>
      </Reveal>
      <Reveal delay={220}>
        <p class="lead">
          Advocacia consultiva em Direito Imobiliário, Notarial e Registral e Planejamento
          Patrimonial e Sucessório — estruturas jurídicas sólidas para famílias e investidores, no
          Brasil e no exterior.
        </p>
      </Reveal>
      <Reveal delay={330}>
        <div class="hero-ctas">
          <Button href={WHATSAPP_URL} variant="gold" external icon="whatsapp" pulse>Falar no WhatsApp</Button>
          <Button href="#areas" variant="ghost">Conheça as áreas</Button>
        </div>
      </Reveal>
      <Reveal delay={430}>
        <ul class="hero-meta">
          <li>Advogada desde 2009</li>
          <li>{OAB}</li>
          <li>Doutora em Direito</li>
        </ul>
      </Reveal>
    </div>

    <Reveal delay={200} class="hero-photo-wrap">
      <span class="hero-photo-halo" aria-hidden="true"></span>
      <figure class="hero-photo">
        <span class="hero-frame" aria-hidden="true"></span>
        <Image
          class="hero-portrait photo-grade"
          src={portrait}
          alt="Dra. Érika Silvana Saquetti Martins, advogada"
          widths={[480, 720, 960]}
          sizes="(max-width: 900px) 88vw, 44vw"
          format="webp"
          quality={82}
          loading="eager"
        />
        <span class="photo-tint" aria-hidden="true"></span>
        <span class="hero-photo-veil" aria-hidden="true"></span>
        <figcaption class="hero-caption">
          <span class="hero-caption-name">Dra. Érika Silvana Saquetti Martins</span>
          <span class="hero-caption-role">Sócia fundadora · {OAB}</span>
        </figcaption>
        <Chip class="chip chip-float">
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
            ><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg
          >
          Brasil · EUA · Canadá · Portugal
        </Chip>
      </figure>
    </Reveal>
  </div>

  <a class="hero-scroll" href="#areas" aria-label="Ir para as áreas de atuação">
    <span class="hero-scroll-ring" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M6 13l6 6 6-6"></path>
      </svg>
    </span>
  </a>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(3rem, 6vw, 5.5rem));
    padding-bottom: clamp(5rem, 8vw, 7rem);
    min-height: min(100svh, 940px);
    display: flex;
    align-items: center;
    background: var(--bg-page);
  }

  /* ---------- fundo ---------- */
  .hero-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: clip;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
    opacity: 0.85;
  }
  /* véu à esquerda: garante contraste do texto sem escurecer a luz da direita */
  .hero-veil-l {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(96deg, var(--color-abyss) 0%, rgba(1, 6, 15, 0.94) 26%, rgba(2, 11, 24, 0.6) 52%, rgba(1, 6, 15, 0.1) 78%),
      radial-gradient(120% 90% at 12% 40%, rgba(4, 30, 66, 0.5) 0%, rgba(1, 6, 15, 0) 60%);
  }
  .hero-veil-b {
    position: absolute;
    inset: auto 0 0 0;
    height: 42%;
    background: linear-gradient(0deg, var(--bg-page) 0%, rgba(1, 6, 15, 0.55) 45%, rgba(1, 6, 15, 0) 100%);
  }

  /* ---------- grade ---------- */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
  }
  .hero-copy h1 {
    text-wrap: balance;
  }
  .hero-copy .lead {
    max-width: 33rem;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 0.4rem;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.1rem;
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .hero-meta li {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .hero-meta li:not(:last-child)::after {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-gold);
  }

  /* ---------- retrato ---------- */
  .hero-photo-wrap {
    position: relative;
    width: 100%;
  }
  .hero-photo {
    position: relative;
    margin: 0 0 0 auto;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(251, 251, 248, 0.12);
    background: var(--color-ink-800);
  }
  /* halo dourado atrás do card — vive no wrapper para não ser cortado
     pelo `overflow: hidden` nem coberto pelo fundo do próprio card */
  .hero-photo-halo {
    position: absolute;
    z-index: 0;
    inset: -16% -12% -10% -10%;
    background: var(--halo-gold);
    filter: blur(12px);
    opacity: 0.9;
    pointer-events: none;
  }
  .hero-frame {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(217, 194, 154, 0.16);
    pointer-events: none;
  }
  .hero-portrait {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 14%;
  }
  .hero-photo-veil {
    position: absolute;
    inset: auto 0 0 0;
    height: 62%;
    background: linear-gradient(0deg, rgba(1, 6, 15, 0.96) 6%, rgba(1, 6, 15, 0.72) 34%, rgba(1, 6, 15, 0) 100%);
    pointer-events: none;
  }
  .hero-caption {
    position: absolute;
    left: clamp(1.1rem, 3vw, 1.6rem);
    right: clamp(1.1rem, 3vw, 1.6rem);
    bottom: clamp(1.1rem, 3vw, 1.5rem);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .hero-caption-name {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-ivory);
  }
  .hero-caption-role {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-light);
  }
  .hero-photo :global(.chip-float) {
    position: absolute;
    z-index: 2;
    top: 1rem;
    left: 1rem;
    max-width: calc(100% - 2rem);
    background: rgba(1, 6, 15, 0.72);
  }

  /* ---------- indicador de rolagem ---------- */
  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 2.5vw, 1.8rem);
    z-index: 2;
    transform: translateX(-50%);
    display: grid;
    place-items: center;
    text-decoration: none;
    color: var(--ink-faint);
    transition: color 0.3s ease;
  }
  .hero-scroll:hover {
    color: var(--color-gold-light);
  }
  .hero-scroll-ring {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(251, 251, 248, 0.16);
    background: rgba(1, 6, 15, 0.5);
    transition: border-color 0.3s ease;
  }
  .hero-scroll:hover .hero-scroll-ring {
    border-color: rgba(217, 194, 154, 0.5);
  }
  .hero-scroll-ring svg {
    width: 17px;
    height: 17px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-scroll-ring svg {
      animation: scroll-hint 2.6s ease-in-out infinite;
    }
    @keyframes scroll-hint {
      0%,
      100% {
        transform: translateY(-2px);
        opacity: 0.6;
      }
      50% {
        transform: translateY(2px);
        opacity: 1;
      }
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      padding-top: calc(var(--header-h) + 2.25rem);
      padding-bottom: clamp(3.5rem, 9vw, 5rem);
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .hero-bg {
      object-position: 78% 30%;
    }
    .hero-veil-l {
      background:
        linear-gradient(180deg, rgba(1, 6, 15, 0.82) 0%, rgba(1, 6, 15, 0.7) 40%, rgba(1, 6, 15, 0.92) 100%),
        radial-gradient(100% 60% at 50% 20%, rgba(4, 30, 66, 0.5) 0%, rgba(1, 6, 15, 0) 70%);
    }
    .hero-photo-wrap {
      order: -1;
    }
    .hero-photo {
      max-width: 420px;
      margin-inline: auto;
      aspect-ratio: 5 / 6;
    }
    .hero-copy {
      align-items: center;
      text-align: center;
    }
    .hero-copy :global([data-reveal]) {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .hero-ctas {
      width: 100%;
      max-width: 26rem;
      flex-direction: column;
    }
    .hero-ctas :global(.btn) {
      width: 100%;
    }
    .hero-meta {
      justify-content: center;
    }
    .hero-scroll {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .hero-photo :global(.chip-float) {
      white-space: normal;
      font-size: 0.8125rem;
    }
  }
</style>
