---
/**
 * Seção 1 — Hero da home (v4).
 *
 * A referência (kbmarketingjuridico.com.br) não usa retrato em card: a pessoa
 * é recortada e "nasce" do fundo escuro. O retrato aqui é gerado por IA
 * (Codex/`gpt-5.6-luna`), com a foto real da Dra. Érika como referência de
 * semelhança, e depois recortado pelo subject lifting do Vision — ver
 * `docs/redesign-v4.md`. Uso autorizado por ela.
 *
 * `--fig-ar` PRECISA bater com a proporção do PNG importado: a caixa da figura
 * é a própria pessoa, e é isso que mantém as tags no mesmo ponto do corpo dela
 * em qualquer largura. Trocou o retrato, atualize as duas variáveis.
 *
 * A figura estica até a base da seção (`margin-bottom: -(--hero-pb)`), então
 * `bottom: 0` dela é a aresta inferior do hero: é ali que o véu de dissolução
 * (`.hero-figure::after`) encosta.
 */
import { Image } from 'astro:assets';
import heroBackdrop from '../../assets/img/v3/hero-backdrop.png';
import portrait from '../../assets/img/v3/erika-retrato-ia.png';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Chip from '../ui/Chip.astro';
import Reveal from '../ui/Reveal.astro';
import { OAB, WHATSAPP_URL } from '../../data/site';
---

<section class="section hero grain" aria-labelledby="hero-title">
  <div class="hero-bg-wrap" aria-hidden="true">
    <Image
      class="hero-bg"
      src={heroBackdrop}
      alt=""
      widths={[1280, 1920, 2560, 3200]}
      sizes="100vw"
      format="webp"
      quality={70}
      loading="eager"
      fetchpriority="high"
    />
    <span class="hero-veil-l"></span>
    <span class="hero-veil-b"></span>
  </div>

  <div class="container hero-container">
    <div class="hero-copy">
      <Reveal>
        <Eyebrow>Advocacia consultiva · Imobiliário &amp; Patrimonial</Eyebrow>
      </Reveal>
      <Reveal delay={110}>
        <h1 id="hero-title">Protegendo patrimônios.<br /><em class="em-gold">Construindo legados.</em></h1>
      </Reveal>
      <Reveal delay={220}>
        <p class="lead">
          Advocacia consultiva em Direito Imobiliário, Notarial e Registral e Planejamento
          Patrimonial e Sucessório — estruturas jurídicas sólidas para famílias e investidores, no
          Brasil e no exterior.
        </p>
      </Reveal>
      <Reveal delay={330}>
        <div class="hero-ctas">
          <Button href={WHATSAPP_URL} variant="gold" size="lg" external icon="whatsapp" pulse>
            Falar no WhatsApp
          </Button>
        </div>
      </Reveal>
      <Reveal delay={430}>
        <ul class="hero-meta">
          <li>Advogada desde 2009</li>
          <li>{OAB}</li>
          <li>Doutora em Direito</li>
        </ul>
      </Reveal>
    </div>

    <Reveal delay={180} class="hero-figure">
      <span class="hero-glow" aria-hidden="true"></span>
      <Image
        class="hero-portrait"
        src={portrait}
        alt="Dra. Érika Silvana Saquetti Martins, advogada"
        widths={[540, 780, 1080, 1308]}
        sizes="(max-width: 900px) 92vw, 46vw"
        format="webp"
        quality={80}
        loading="eager"
      />
      <Chip class="hero-tag hero-tag-nome">Dra. Érika Saquetti Martins</Chip>
      <Chip class="hero-tag hero-tag-paises">
        <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
          ><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg
        >
        Brasil · EUA · Canadá · Portugal
      </Chip>
    </Reveal>
  </div>

  <a class="hero-scroll" href="#areas" aria-label="Ir para as áreas de atuação">
    <span class="hero-scroll-ring" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M6 13l6 6 6-6"></path>
      </svg>
    </span>
  </a>
</section>

<style>
  .hero {
    --hero-pb: clamp(5rem, 8vw, 7rem);
    --fig-ar: 1308 / 1645;
    --fig-arw: 0.7951;
    /* Escala da figura no desktop. Na referência a pessoa ocupa ~22% da
       largura da tela e sobra fundo à direita dela — ela NÃO encosta na borda.
       Sem este teto a figura acompanhava a coluna e ficava grande demais. */
    --fig-max: clamp(320px, 33vw, 470px);
    padding-top: calc(var(--header-h) + clamp(2rem, 4vw, 3.5rem));
    padding-bottom: var(--hero-pb);
    min-height: min(100svh, 940px);
    display: flex;
    align-items: stretch;
    background: var(--bg-page);
  }

  /* ---------- fundo ---------- */
  .hero-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: clip;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 100% center;
  }
  /* véu à esquerda: garante contraste do texto sem apagar o feixe da direita */
  .hero-veil-l {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(96deg, var(--color-abyss) 0%, rgba(1, 6, 15, 0.92) 24%, rgba(2, 11, 24, 0.55) 48%, rgba(1, 6, 15, 0.08) 76%),
      radial-gradient(120% 90% at 10% 42%, rgba(4, 30, 66, 0.45) 0%, rgba(1, 6, 15, 0) 62%);
  }
  .hero-veil-b {
    position: absolute;
    inset: auto 0 0 0;
    height: 38%;
    background: linear-gradient(0deg, var(--bg-page) 0%, rgba(1, 6, 15, 0.5) 48%, rgba(1, 6, 15, 0) 100%);
  }

  /* ---------- grade ---------- */
  .hero-container {
    display: grid;
    grid-template-columns: minmax(0, 52fr) minmax(0, 48fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
    padding-block: clamp(0.5rem, 2vw, 1.5rem);
  }
  .hero-copy h1 {
    text-wrap: balance;
  }
  .hero-copy .lead {
    max-width: 33rem;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 0.5rem;
  }
  /* Botão único e generoso, como na referência (lá ele ocupa ~86% da coluna
     de texto). Em `min-width` NÃO dá para usar porcentagem: `.hero-copy` tem
     `align-items: flex-start`, então o wrapper encolhe até o conteúdo e o
     `100%` passaria a ser a largura do próprio botão. */
  .hero-ctas :global(.btn) {
    min-width: 25rem;
    max-width: 100%;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.1rem;
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .hero-meta li {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .hero-meta li:not(:last-child)::after {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-gold);
  }

  /* ---------- retrato recortado ----------
     A figura tem a PROPORÇÃO EXATA do PNG (ver `--fig-ar`), então a caixa é a
     própria Érika: as tags podem ser posicionadas em % e continuam no mesmo
     ponto do corpo dela em qualquer largura. A margem negativa desce a caixa
     até a aresta inferior da seção, para sangrar como na referência. */
  .hero-container :global(.hero-figure) {
    position: relative;
    align-self: end;
    justify-self: center;
    aspect-ratio: var(--fig-ar);
    width: 100%;
    max-width: var(--fig-max);
    margin-bottom: calc(-1 * var(--hero-pb));
  }
  .hero-glow {
    position: absolute;
    z-index: 0;
    left: 52%;
    top: 46%;
    width: 122%;
    aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%);
    background: var(--halo-gold);
    filter: blur(14px);
    opacity: 0.85;
    pointer-events: none;
  }
  .hero-portrait {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom right;
  }
  /* dissolução: a figura encosta na aresta inferior e some no fundo da página */
  .hero-container :global(.hero-figure)::after {
    content: "";
    position: absolute;
    z-index: 2;
    inset: auto 0 0 0;
    height: clamp(96px, 20%, 190px);
    background: linear-gradient(0deg, var(--bg-page) 10%, rgba(1, 6, 15, 0.7) 48%, rgba(1, 6, 15, 0) 100%);
    pointer-events: none;
  }

  .hero-container :global(.hero-tag) {
    position: absolute;
    z-index: 3;
    max-width: calc(100% - 1rem);
  }
  /* abaixo do queixo e do peito: as tags encostam nela sem cobrir o rosto */
  .hero-container :global(.hero-tag-nome) {
    top: 52%;
    left: -16%;
  }
  .hero-container :global(.hero-tag-paises) {
    top: 68%;
    left: -26%;
  }
  /* entre 901 e 1150 px a coluna de texto encosta na figura: as tags recolhem
     para cima dela em vez de invadirem o parágrafo */
  @media (max-width: 1150px) {
    .hero-container :global(.hero-tag-nome) {
      top: 51%;
      left: -3%;
    }
    .hero-container :global(.hero-tag-paises) {
      top: 67%;
      left: -9%;
    }
  }
  /* a linha de credenciais tem de caber numa linha só */
  @media (max-width: 1150px) {
    .hero-meta {
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
      gap: 0.5rem 0.85rem;
    }
    .hero-meta li {
      gap: 0.85rem;
    }
  }

  /* ---------- indicador de rolagem ---------- */
  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 2.5vw, 1.8rem);
    z-index: 4;
    transform: translateX(-50%);
    display: grid;
    place-items: center;
    text-decoration: none;
    color: var(--ink-faint);
    transition: color 0.3s ease;
  }
  .hero-scroll:hover {
    color: var(--color-gold-light);
  }
  .hero-scroll-ring {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(251, 251, 248, 0.16);
    background: rgba(1, 6, 15, 0.5);
    transition: border-color 0.3s ease;
  }
  .hero-scroll:hover .hero-scroll-ring {
    border-color: rgba(217, 194, 154, 0.5);
  }
  .hero-scroll-ring svg {
    width: 17px;
    height: 17px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-scroll-ring svg {
      animation: scroll-hint 2.6s ease-in-out infinite;
    }
    @keyframes scroll-hint {
      0%,
      100% {
        transform: translateY(-2px);
        opacity: 0.6;
      }
      50% {
        transform: translateY(2px);
        opacity: 1;
      }
    }
  }

  /* ---------- empilhado ---------- */
  @media (max-width: 900px) {
    .hero {
      --hero-pb: clamp(3rem, 8vw, 4.5rem);
      min-height: 0;
      padding-top: calc(var(--header-h) + 1.25rem);
      display: block;
    }
    .hero-container {
      grid-template-columns: 1fr;
      gap: 0;
    }
    /* empilhado o hero fica alto e o `cover` amplia muito o backdrop: sem um
       véu mais forte o feixe dourado vira uma laje clara atrás dela. */
    .hero-bg {
      object-position: 58% 26%;
    }
    .hero-veil-l {
      background:
        linear-gradient(180deg, rgba(1, 6, 15, 0.82) 0%, rgba(1, 6, 15, 0.7) 30%, rgba(1, 6, 15, 0.95) 100%),
        radial-gradient(90% 42% at 50% 14%, rgba(4, 30, 66, 0.4) 0%, rgba(1, 6, 15, 0) 74%);
    }
    /* a figura vira um bloco no topo, sangrando de borda a borda */
    /* bloco de foto no topo, de borda a borda — mas com a ALTURA amarrada a
       ~54svh (a proporção da referência). Sem esse teto, em 768 px de largura
       a figura passava de 890 px de altura e empurrava todo o texto do hero
       para fora da tela. `justify-self: center` mantém o sangramento simétrico
       mesmo quando a caixa é mais larga que o container. */
    .hero-container :global(.hero-figure) {
      order: -1;
      align-self: auto;
      justify-self: center;
      width: calc(100% + 2 * var(--container-pad));
      max-width: calc(54svh * var(--fig-arw));
      margin: 0 0 clamp(0.25rem, 2vw, 1rem);
    }
    .hero-portrait {
      object-position: bottom center;
    }
    /* o véu tem de atravessar a seção inteira: limitado à largura da figura,
       ele pintava o fundo sólido num painel mais estreito que o hero e a
       emenda vertical aparecia nas laterais (visível sobretudo em 768 px).
       A seção tem `overflow: clip`, então o excedente não gera rolagem. */
    .hero-container :global(.hero-figure)::after {
      inset: auto -50vw 0 -50vw;
      height: 30%;
      background: linear-gradient(0deg, var(--bg-page) 4%, rgba(1, 6, 15, 0.6) 52%, rgba(1, 6, 15, 0) 100%);
    }
    .hero-container :global(.hero-tag) {
      font-size: 0.8125rem;
      max-width: calc(100% - 2 * var(--container-pad));
    }
    .hero-container :global(.hero-tag-nome) {
      top: 60%;
      left: var(--container-pad);
    }
    .hero-container :global(.hero-tag-paises) {
      top: 76%;
      left: var(--container-pad);
    }
    .hero-copy {
      align-items: center;
      text-align: center;
      padding-block: 0;
    }
    .hero-copy :global([data-reveal]) {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .hero-ctas {
      width: 100%;
      max-width: 26rem;
    }
    .hero-ctas :global(.btn) {
      width: 100%;
      min-width: 0;
    }
    .hero-meta {
      justify-content: center;
    }
    .hero-scroll {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .hero-container :global(.hero-tag-paises) {
      white-space: normal;
    }
  }
</style>
